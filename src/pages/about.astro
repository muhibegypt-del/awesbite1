---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import SectionHead from '../components/SectionHead.astro';
import Honours from '../components/Honours.astro';
import Photo from '../components/Photo.astro';
import { q } from '../lib/typeset.js';
import site from '../content/site.json';
import pages from '../content/pages.json';
import global from '../content/global.json';

const { about } = site;
const labels = pages.about;
/* One paragraph names the Television Workshop: it keeps its link. */
const linked = (line: string) => {
  const { text, href } = about.workshopLink;
  if (!line.includes(text)) return null;
  const [before, after] = line.split(text);
  return { before, after, text, href };
};
---

<Base title={pages.meta.about.title} description={pages.meta.about.description}>
  <Masthead runhead={labels.marker} title={about.heading}>
    <p slot="below" class="lead">{q(about.intro)}</p>
  </Masthead>

  <section class="sec" aria-label={about.heading}>
    <div class="bleed about">
      {/* The anthology portrait, cropped close and upright: Narration shows
          the same frame whole and wide, so the two read as different. */}
      <div class="about__photo reveal">
        <Photo src={about.portrait} alt={about.portraitAlt} sizes="(min-width: 1024px) 40vw, 100vw" eager />
      </div>
      <div class="about__text prose reveal">
        {about.paragraphs.map((line) => {
          const link = linked(line);
          return link
            ? <p>{q(link.before)}<a href={link.href} target="_blank" rel="noopener noreferrer">{link.text}<span class="visually-hidden">{global.newTab}</span></a>{q(link.after)}</p>
            : <p>{q(line)}</p>;
        })}
      </div>
      <Honours />
    </div>
  </section>

  <section class="sec" aria-labelledby="beyond-heading">
    <div class="bleed">
      <SectionHead label={labels.beyondMarker} heading={labels.beyondHeading} lead={about.reflectionBody} id="beyond-heading">
        <a class="textlink" href={labels.contentLink.href}>{labels.contentLink.label} <span class="arrow" aria-hidden="true">→</span></a>
      </SectionHead>
    </div>
  </section>
</Base>
