---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import SectionHead from '../components/SectionHead.astro';
import Honours from '../components/Honours.astro';
import Photo from '../components/Photo.astro';
import { q } from '../lib/typeset.js';
import site from '../content/site.json';
import pages from '../content/pages.json';

const { about } = site;
const labels = pages.about;
---

<Base title={pages.meta.about.title} description={pages.meta.about.description}>
  <Masthead runhead={labels.marker} title={about.heading}>
    <p slot="below" class="lead">{q(about.empathy)}</p>
  </Masthead>

  <section class="sec" aria-label={about.heading}>
    <div class="bleed about">
      {/* The anthology portrait, cropped close and upright: Narration shows
          the same frame whole and wide, so the two read as different. */}
      <div class="about__photo reveal">
        <Photo src={about.portrait} alt={about.portraitAlt} sizes="(min-width: 1024px) 40vw, 100vw" />
      </div>
      <div class="about__text prose reveal">
        {about.paragraphs.map((line) => <p>{q(line)}</p>)}
      </div>
      <Honours />
    </div>
  </section>

  <section class="sec sec--band" aria-labelledby="experience-heading">
    <div class="bleed">
      <SectionHead label={labels.experienceMarker} labelAs="h2" lead={about.authority} id="experience-heading" />
      <div class="prose col-text reveal">
        <p>{q(about.teachingBodies)}</p>
        <h3 class="h3 space-5">{about.whyHeading}</h3>
        {about.why.map((line) => <p>{q(line)}</p>)}
        <a class="textlink" href={labels.teachingLink.href}>{labels.teachingLink.label} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="beyond-heading">
    <div class="bleed">
      <SectionHead label={labels.beyondMarker} heading={labels.beyondHeading} lead={about.reflectionBody} id="beyond-heading">
        <a class="textlink" href={labels.contentLink.href}>{labels.contentLink.label} <span class="arrow" aria-hidden="true">→</span></a>
      </SectionHead>
    </div>
  </section>
</Base>
