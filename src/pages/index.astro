---
/** The hub. Says plainly what she offers and routes to the three services
    first, then her own introduction with the qualifications, the name on
    the plum band, and the close on the one action (approval PDF section
    02). About and Content have their own pages, so they are not repeated
    here. */
import Base from '../layouts/Base.astro';
import HubHero from '../components/HubHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Honours from '../components/Honours.astro';
import EssayBand from '../components/EssayBand.astro';
import { q } from '../lib/typeset.js';
import site from '../content/site.json';
import global from '../content/global.json';

const { hub, contact } = site;
const { story, audience, welcome } = hub.landing;
---

<Base title={global.meta.title} bare>
  <HubHero />

  <section class="sec" aria-labelledby="story-heading">
    <div class="bleed">
      <SectionHead label={hub.markers.authority} labelAs="h2" id="story-heading" />
      <div class="prose col-text reveal">
        {story.map((line) => <p>{q(line)}</p>)}
        <p class="lead">{q(audience)}</p>
        <p class="lead hello__welcome"><em>{welcome}</em></p>
        <a class="textlink" href={hub.authorityLink.href}>{hub.authorityLink.label} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <Honours />
    </div>
  </section>

  <EssayBand />

  <section class="sec sec--band" aria-labelledby="close-heading">
    <div class="bleed">
      <SectionHead label={hub.markers.close} heading={contact.heading} lead={contact.line} id="close-heading">
        <p><a class="btn" href={global.nav.cta.href}>{global.nav.cta.label}</a></p>
      </SectionHead>
    </div>
  </section>
</Base>
