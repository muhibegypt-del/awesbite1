---
/**
 * The hub, composed in one direction: what the home page would be. The
 * collage frames this at phone and tablet widths, and it can be opened
 * directly on a real device. Internal, noindex, never linked.
 */
import Direction from '../../../layouts/Direction.astro';
import Header from '../../../components/direction/Header.astro';
import Hero from '../../../components/direction/Hero.astro';
import Contents from '../../../components/direction/Contents.astro';
import Honours from '../../../components/direction/Honours.astro';
import Essay from '../../../components/direction/Essay.astro';
import Footer from '../../../components/direction/Footer.astro';
import directions from '../../../content/directions.json';

export function getStaticPaths() {
  return [{ params: { d: 'a' } }, { params: { d: 'b' } }];
}

const d = Astro.params.d as 'a' | 'b';
---

<Direction direction={d} title={`${directions[d].label}: home`}>
  <Header />
  <main>
    <Hero direction={d} />
    <Contents />
    <Honours />
    <Essay />
  </main>
  <Footer />
</Direction>
