---
/** The one destination for every call to action on the site. */
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import ContactForm from '../components/ContactForm.astro';
import { q } from '../lib/typeset.js';
import global from '../content/global.json';
import site from '../content/site.json';
import pages from '../content/pages.json';
---

<Base title={pages.meta.contact.title} description={pages.meta.contact.description}>
  <Masthead runhead={pages.contact.marker} title={site.contact.heading}>
    <p slot="below" class="lead">{q(site.contact.line)}</p>
  </Masthead>

  <section class="sec" aria-label={pages.meta.contact.title}>
    <div class="bleed">
      <div class="col-text">
        <ContactForm />
        <p class="small muted space-7">{pages.contact.direct} <a class="textlink" href={`mailto:${global.contact.email}`}>{global.contact.email}</a></p>
      </div>
    </div>
  </section>
</Base>
