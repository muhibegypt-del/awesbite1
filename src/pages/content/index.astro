---
/**
 * Content as one page (approval PDF section 07): the introduction and why
 * this strand of work exists, then where to find it, then collaborations.
 * A platform appears only once its link exists in content-links.json, so
 * there is never an empty placeholder section. The old sub-page addresses
 * redirect to the matching section here.
 */
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import SectionHead from '../../components/SectionHead.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { q } from '../../lib/typeset.js';
import site from '../../content/site.json';
import pages from '../../content/pages.json';
import links from '../../content/content-links.json';
import global from '../../content/global.json';
import { discovery } from '../../lib/discovery.js';

const c = pages.content;
const intro = pages.introduction;
const platforms = [
  { id: 'substack', ...pages.substack, url: links.substack },
  { id: 'youtube', ...pages.youtube, url: links.youtube },
].filter((platform) => platform.url);
const socials = links.socials.filter((link) => link.url);
const collab = pages.collaborations;
---

<Base title={pages.meta.content.title} description={pages.meta.content.description} italicFirst>
  <Masthead runhead={c.marker} title={c.heading}>
    <Fragment slot="below">
      <p class="lead">{q(site.about.reflectionBody)}</p>
      <ul class="tagline" role="list">{site.about.reflectionTags.map((tag) => <li>{tag}</li>)}</ul>
      <p class="masthead__actions"><a class="btn btn--lg" href={discovery.href} target={discovery.external ? '_blank' : undefined} rel={discovery.external ? 'noopener noreferrer' : undefined}>{discovery.label}{discovery.external && <span class="visually-hidden">{global.newTab}</span>}</a></p>
    </Fragment>
  </Masthead>

  <section class="sec sec--cream" id="introduction" aria-labelledby="introduction-heading">
    <div class="bleed">
      <SectionHead label={intro.marker} heading={intro.heading} id="introduction-heading" />
      {/* Her introduction as one passage in the home page's body face (client revisions, November 2026). */}
      <article class="prose col-text">
        <p>{q(intro.lede)}</p>
        {intro.paragraphs.map((line) => <p>{q(line)}</p>)}
      </article>
    </div>
  </section>

  {platforms.map((platform) => (
    <section class="sec sec--minor" id={platform.id} aria-labelledby={`${platform.id}-heading`}>
      <div class="bleed">
        <SectionHead label={platform.heading} labelAs="h2" id={`${platform.id}-heading`} />
        <div class="prose col-text">
          <p class="lead">{q(platform.lede)}</p>
          {/* Her latest posts, filled from /api/substack (owner's request, November 2026); hidden until there are some. */}
          {platform.id === 'substack' && <ul class="posts" role="list" data-feed="/api/substack" data-locale={global.meta.locale.replace('_', '-')} hidden></ul>}
          <a class="textlink" href={platform.url} target="_blank" rel="noopener noreferrer">{platform.linkLabel}<span class="visually-hidden">{global.newTab}</span></a>
        </div>
      </div>
    </section>
  ))}

  {socials.length > 0 && (
    <section class="sec sec--minor" id="socials" aria-labelledby="socials-heading">
      <div class="bleed">
        <SectionHead label={pages.socials.heading} labelAs="h2" id="socials-heading" />
        <div class="prose col-text">
          <p class="lead">{q(pages.socials.lede)}</p>
          <SocialLinks links={socials} named newTab />
        </div>
      </div>
    </section>
  )}

  <section class="sec sec--band" id="collaborations" aria-labelledby="collaborations-heading">
    <div class="bleed">
      <SectionHead label={collab.heading} labelAs="h2" id="collaborations-heading" />
      <div class="prose col-text">
        <p class="lead">{q(collab.lede)}</p>
        <ul class="dash-list" role="list">{site.about.openTo.map((item) => <li>{q(item)}</li>)}</ul>
        <a class="textlink" href={`mailto:${global.contact.email}`}>{collab.linkLabel}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  /* Fill her Substack posts from the site's own feed reader. Text only
     (textContent), new tab for each post, nothing shown if the list is
     empty or the request fails. */
  const list = document.querySelector<HTMLUListElement>('[data-feed]');
  if (list) {
    fetch(list.dataset.feed!)
      .then((response) => (response.ok ? response.json() : { items: [] }))
      .then(({ items }: { items: { title: string; link: string; date: string; summary: string }[] }) => {
        if (!items?.length) return;
        const format = new Intl.DateTimeFormat(list.dataset.locale || 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
        for (const post of items) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'textlink posts__title';
          a.href = post.link;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = post.title;
          li.append(a);
          if (post.date) {
            const time = document.createElement('time');
            time.className = 'posts__date';
            time.dateTime = post.date;
            time.textContent = format.format(new Date(post.date));
            li.append(time);
          }
          if (post.summary) {
            const p = document.createElement('p');
            p.className = 'posts__summary';
            p.textContent = post.summary;
            li.append(p);
          }
          list.append(li);
        }
        list.hidden = false;
      })
      .catch(() => {});
  }
</script>
