---
/**
 * Content as one page (approval PDF section 07): the introduction and why
 * this strand of work exists, then where to find it, then collaborations.
 * A platform appears only once its link exists in content-links.json, so
 * there is never an empty placeholder section. The old sub-page addresses
 * redirect to the matching section here.
 */
import Base from '../../layouts/Base.astro';
import Masthead from '../../components/Masthead.astro';
import SectionHead from '../../components/SectionHead.astro';
import { q } from '../../lib/typeset.js';
import site from '../../content/site.json';
import pages from '../../content/pages.json';
import links from '../../content/content-links.json';
import global from '../../content/global.json';

const c = pages.content;
const intro = pages.introduction;
const platforms = [
  { id: 'substack', ...pages.substack, url: links.substack },
  { id: 'youtube', ...pages.youtube, url: links.youtube },
].filter((platform) => platform.url);
const socials = links.socials.filter((link) => link.url);
const collab = pages.collaborations;
---

<Base title={pages.meta.content.title} description={pages.meta.content.description}>
  <Masthead runhead={c.marker} title={c.heading}>
    <Fragment slot="below">
      <p class="lead">{q(site.about.reflectionBody)}</p>
      <ul class="tagline" role="list">{site.about.reflectionTags.map((tag) => <li>{tag}</li>)}</ul>
    </Fragment>
  </Masthead>

  <section class="sec" id="introduction" aria-labelledby="introduction-heading">
    <div class="bleed">
      <SectionHead label={intro.marker} heading={intro.heading} id="introduction-heading" />
      <article class="essay-page col-text">
        <p class="lead">{q(intro.lede)}</p>
        {intro.paragraphs.map((line) => <p>{q(line)}</p>)}
      </article>
    </div>
  </section>

  {platforms.map((platform) => (
    <section class="sec sec--minor" id={platform.id} aria-labelledby={`${platform.id}-heading`}>
      <div class="bleed">
        <SectionHead label={platform.heading} labelAs="h2" id={`${platform.id}-heading`} />
        <div class="prose col-text">
          <p class="lead">{q(platform.lede)}</p>
          <a class="textlink" href={platform.url} target="_blank" rel="noopener noreferrer">{platform.linkLabel}<span class="visually-hidden">{global.newTab}</span></a>
        </div>
      </div>
    </section>
  ))}

  {socials.length > 0 && (
    <section class="sec sec--minor" id="socials" aria-labelledby="socials-heading">
      <div class="bleed">
        <SectionHead label={pages.socials.heading} labelAs="h2" id="socials-heading" />
        <div class="prose col-text">
          <p class="lead">{q(pages.socials.lede)}</p>
          <ul class="library" role="list">
            {socials.map((link) => <li><a class="textlink" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="visually-hidden">{global.newTab}</span></a></li>)}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="sec sec--band" id="collaborations" aria-labelledby="collaborations-heading">
    <div class="bleed">
      <SectionHead label={collab.heading} labelAs="h2" id="collaborations-heading" />
      <div class="prose col-text">
        <p class="lead">{q(collab.lede)}</p>
        <ul class="dash-list" role="list">{site.about.openTo.map((item) => <li>{q(item)}</li>)}</ul>
        <a class="textlink" href={`mailto:${global.contact.email}`}>{collab.linkLabel}</a>
      </div>
    </div>
  </section>
</Base>
