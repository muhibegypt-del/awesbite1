---
import Content from '../../layouts/Content.astro';
import Masthead from '../../components/Masthead.astro';
import SectionHead from '../../components/SectionHead.astro';
import { q } from '../../lib/typeset.js';
import site from '../../content/site.json';
import pages from '../../content/pages.json';
import links from '../../content/content-links.json';
import global from '../../content/global.json';

const c = pages.content;
---

<Content page="content">
  <Masthead runhead={c.marker} title={c.heading}>
    <Fragment slot="below">
      <p class="lead">{q(site.about.reflectionBody)}</p>
      <ul class="tagline" role="list">{site.about.reflectionTags.map((tag) => <li>{tag}</li>)}</ul>
      <a class="textlink" href={c.introLink.href}>{c.introLink.label} <span class="arrow" aria-hidden="true">→</span></a>
    </Fragment>
  </Masthead>

  <section class="sec sec--band" aria-labelledby="explore-heading">
    <div class="bleed">
      <SectionHead label={c.exploreMarker} heading={c.exploreHeading} id="explore-heading" />
      <ol class="contents routes" role="list">
        {c.routes.map((route) => (
          <li class="entry reveal">
            <h3 class="entry__title"><a href={route.href}>{route.title}</a></h3>
            <p class="entry__one">{q(route.body)}</p>
            <p class="entry__who">{c.routeCue.replace(' →', '')} <span class="arrow" aria-hidden="true">→</span></p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec sec--minor" aria-labelledby="library-heading">
    <div class="bleed">
      <SectionHead label={c.libraryHeading} labelAs="h2" id="library-heading" />
      <ul class="library col-text" role="list">
        {links.library.map((link) => (
          <li>{link.url
            ? <a class="textlink" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="visually-hidden">{global.newTab}</span></a>
            : <>{link.label}<small>{c.libraryPending}</small></>}</li>
        ))}
      </ul>
    </div>
  </section>
</Content>
