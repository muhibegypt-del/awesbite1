---
import ContentLayout from '../../components/ContentLayout.astro';
import links from '../../content/content-links.json';
---
<ContentLayout title="Socials" description="Find a textured word on LinkedIn, Instagram and TikTok.">
  <section class="page-hero"><div class="container stack">
    <h1>Socials</h1>
    <p class="t-lead">Words of the week, close readings, narrated extracts and takeaways.</p>
    <ul class="social-list" role="list">{links.socials.map((link) => <li>{link.url
      ? <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="visually-hidden"> (opens in a new tab)</span></a>
      : <span>{link.label} <small>— link coming soon</small></span>}</li>)}</ul>
    <a class="link-rule" href="/content">Back to Content</a>
  </div></section>
</ContentLayout>
<style>.social-list { display: grid; gap: var(--s-4); } small { color: var(--ink-soft); }</style>
