---
import Content from '../../layouts/Content.astro';
import Masthead from '../../components/Masthead.astro';
import { q } from '../../lib/typeset.js';
import pages from '../../content/pages.json';
import links from '../../content/content-links.json';
import global from '../../content/global.json';

const p = pages.socials;
---

<Content page="socials">
  <Masthead title={p.heading}>
    <Fragment slot="below">
      <p class="lead">{q(p.lede)}</p>
      <ul class="library" role="list">
        {links.socials.map((link) => (
          <li>{link.url
            ? <a class="textlink" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="visually-hidden">{global.newTab}</span></a>
            : <>{link.label}<small>{p.pending}</small></>}</li>
        ))}
      </ul>
      <a class="textlink" href="/content">{pages.content.backLink}</a>
    </Fragment>
  </Masthead>
</Content>
