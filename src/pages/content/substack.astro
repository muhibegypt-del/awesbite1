---
import Content from '../../layouts/Content.astro';
import Masthead from '../../components/Masthead.astro';
import { q } from '../../lib/typeset.js';
import pages from '../../content/pages.json';
import links from '../../content/content-links.json';
import global from '../../content/global.json';

const p = pages.substack;
const url = links.substack;
---

<Content page="substack">
  <Masthead title={p.heading}>
    <Fragment slot="below">
      <p class="lead">{q(p.lede)}</p>
      {url
        ? <a class="textlink" href={url} target="_blank" rel="noopener noreferrer">{p.linkLabel}<span class="visually-hidden">{global.newTab}</span></a>
        : <p class="pending-quote">{p.pending}</p>}
      <a class="textlink" href="/content">{pages.content.backLink}</a>
    </Fragment>
  </Masthead>
</Content>
