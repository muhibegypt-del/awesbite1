---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { q } from '../lib/typeset.js';
import site from '../content/site.json';
import pages from '../content/pages.json';
---

<Base title={pages.meta.notFound.title} noindex>
  <Masthead title={site.notFound.heading}>
    <Fragment slot="below">
      <p class="lead">{q(site.notFound.body)}</p>
      <a class="textlink" href="/">{pages.common.backToSite} <span class="arrow" aria-hidden="true">→</span></a>
    </Fragment>
  </Masthead>
</Base>
