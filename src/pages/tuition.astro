---
/** Spoke: English tuition. */
import Base from '../layouts/Base.astro';
import ServicePage from '../components/ServicePage.astro';
import site from '../content/site.json';

const service = site.services.find((s) => s.id === 'tuition');
---

<Base title="English tuition" description="One-to-one English tuition for children and adults. Primary through GCSE, A-Level, IELTS and adult learners. Book a free assessment.">
  <ServicePage service={service} />
</Base>
