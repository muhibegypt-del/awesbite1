---
/**
 * The three pillars. On the hub they are the main event; on a spoke they sit
 * under the hero so the other two audiences always have an exit.
 *
 * Each card is one link with one accessible name. The spans are given explicit
 * separators rather than relying on a CSS gap — a gap is not a space, and the
 * accessibility tree concatenated them into "English tuitionthe taught word".
 */
import site from '../content/site.json';

interface Props {
  /** Route of the page this renders on, so it can mark itself. */
  current?: string;
  /** Cards are larger and carry the one-liner on the hub. */
  full?: boolean;
}

const { current = '', full = false } = Astro.props;
const { services } = site;
---

<ul class={`pillars columns columns--aligned ${full ? 'pillars--full' : ''}`} role="list">
  {
    services.map((service) => {
      const isCurrent = service.route === current;
      const label = `${service.pillar}: ${service.plain}`;
      return (
        <li class="pillar">
          {isCurrent ? (
            <div class="pillar__inner pillar__inner--current" aria-current="page">
              <p class="slug" aria-hidden="true">{service.number} — {service.tag}</p>
              <p class="pillar__name">{service.pillar}</p>
              <p class="pillar__plain">{service.plain}</p>
              {full && <p class="pillar__line">{service.oneLiner}</p>}
              <p class="pillar__state">You are here</p>
            </div>
          ) : (
            <a class="pillar__inner" href={service.route} aria-label={label}>
              <span class="slug" aria-hidden="true">{service.number} — {service.tag}</span>
              <span class="pillar__name">{service.pillar}</span>
              <span class="pillar__plain">{service.plain}</span>
              {full && <span class="pillar__line">{service.oneLiner}</span>}
              <span class="pillar__state" aria-hidden="true">{service.audience} →</span>
            </a>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .pillar__inner {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    align-content: start;
    height: 100%;
    text-decoration: none;
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease);
  }

  @supports (grid-template-rows: subgrid) {
    @media (min-width: 768px) {
      .pillar__inner {
        display: grid;
        grid-template-rows: subgrid;
        grid-row: span 5;
      }
    }
  }

  .pillar__name {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    /* --t-h3 on a card, not --t-h2. At --t-h2 a three-word service name in a
       one-third column ran to three lines while its neighbour ran to one. */
    font-size: var(--t-h3);
    margin: 0;
  }

  .pillars--full .pillar__name {
    font-size: var(--t-h2);
  }

  .pillar__plain {
    font-family: var(--font-display);
    font-size: var(--t-body);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
    color: var(--ink-soft);
    margin: 0;
  }

  .pillar__line {
    font-size: var(--t-body);
    line-height: 1.6;
    margin: 0;
    max-inline-size: none;
  }

  .pillar__state {
    align-self: end;
    margin: 0;
    padding-block-start: var(--s-4);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--clay-ink);
  }

  .pillar__inner:hover {
    color: var(--clay-ink);
  }

  .pillar__inner--current {
    color: var(--ink-soft);
  }

  .pillar__inner--current .pillar__name {
    color: var(--ink);
  }
</style>
