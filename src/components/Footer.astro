---
/**
 * The close, in plum. Social and legal links render only once their URLs
 * exist: never a dead link, never an empty column.
 */
import Wordmark from './Wordmark.astro';
import global from '../content/global.json';

const { footer, social } = global;
const socialLinks = social.links.filter((link) => link.url);
const legalLinks = footer.legalLinks.filter((link) => link.href);
---

<footer class="ftr">
  <div class="bleed">
    <div class="ftr__brand">
      <Wordmark class="ftr__mark" />
      <p class="ftr__tagline">{footer.tagline}</p>
    </div>

    {footer.columns.map((column) => (
      <div class="ftr__col">
        <p class="label ftr__heading">{column.heading}</p>
        <ul role="list">
          {column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    ))}

    {socialLinks.length > 0 && (
      <div class="ftr__col">
        <p class="label ftr__heading">{social.heading}</p>
        <ul role="list">
          {socialLinks.map((link) => <li><a href={link.url} rel="me noopener">{link.label}</a></li>)}
        </ul>
      </div>
    )}

    <div class="ftr__legal">
      <p>{footer.legal}</p>
      {legalLinks.length > 0 && (
        <ul role="list">{legalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      )}
    </div>
  </div>
</footer>
