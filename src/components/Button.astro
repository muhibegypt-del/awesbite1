---
/**
 * Button — renders <a> when given an href, <button> otherwise.
 *
 * Only ONE variant="primary" may be visible per viewport, per page.
 * Body face, never mono. Radius 2px. No box-shadow.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'quiet';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'secondary',
  href,
  type = 'button',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, className].filter(Boolean).join(' ');
const tagProps = href ? { href } : { type, disabled };
---

<Tag class={classes} {...tagProps} {...rest}>
  <span class="btn__label"><slot /></span>
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    /* 44px minimum target, and enough width that the label is not the only
       thing giving the control its shape. Narrower on phones, where the
       header lockup and this button have to share one row. */
    min-height: 44px;
    padding: var(--s-3) var(--s-5);
    font-family: var(--font-body);
    font-size: var(--t-body);
    font-weight: 500;
    line-height: var(--lh-tight);
    letter-spacing: var(--track-body);
    text-align: center;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  /* Primary — solid clay-ink. paper on clay-ink is 5.77:1. */
  .btn--primary {
    background: var(--clay-ink);
    color: var(--paper);
    border-color: var(--clay-ink);
  }

  .btn--primary:hover:not(:disabled) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* Secondary — hairline outline, ink label. */
  .btn--secondary {
    background: transparent;
    color: var(--ink);
    border-color: var(--rule);
  }

  .btn--secondary:hover:not(:disabled) {
    border-color: var(--clay-ink);
    color: var(--clay-ink);
  }

  /* Quiet — a link that carries a button's hit area. */
  @media (min-width: 768px) {
    .btn:not(.btn--quiet) {
      padding-inline: var(--s-6);
    }
  }

  .btn--quiet {
    min-height: 0;
    padding-inline: 0;
    background: transparent;
    color: var(--clay-ink);
  }

  .btn--quiet .btn__label {
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--s-1);
    transition: border-color var(--dur-fast) var(--ease);
  }

  .btn--quiet:hover:not(:disabled) {
    color: var(--ink);
  }

  .btn--quiet:hover:not(:disabled) .btn__label {
    border-bottom-color: var(--clay);
  }
</style>
