---
interface Props { id: string; title: string; tag?: string; src?: string | null }
const { id, title, tag, src } = Astro.props;
---
<div class="audio-player" data-audio-player>
  <div class="audio-player__heading">
    <p id={`track-title-${id}`}>{title}</p>
    {tag && <span>{tag}</span>}
  </div>
  {src ? (
    <>
      <audio controls preload="metadata" src={src} aria-labelledby={`track-title-${id}`}></audio>
      <div class="audio-player__controls" data-controls hidden>
        <button type="button" class="audio-player__play" data-play
          aria-label={`Play ${title}`} data-title={title} disabled>
          <svg data-play-icon viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 4v16l14-8z" fill="currentColor"/></svg>
          <svg data-pause-icon viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" hidden><path d="M6 4h4v16H6zm8 0h4v16h-4z" fill="currentColor"/></svg>
        </button>
        <input type="range" min="0" max="100" step="0.1" value="0" disabled
          aria-label={`Seek in ${title}`} data-seek />
        <span class="audio-player__time"><span data-elapsed>0:00</span> / <span data-duration>0:00</span></span>
      </div>
      <p class="audio-player__status" data-audio-status role="status"></p>
    </>
  ) : (
    <>
      <div class="audio-player__controls">
        <button class="audio-player__play" type="button" disabled aria-label="Voice sample not yet available">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M7 4v16l14-8z" fill="currentColor"/></svg>
        </button>
        <input type="range" value="0" disabled aria-label="Voice sample not yet available" />
        <span class="audio-player__time">— / —</span>
      </div>
      <p class="audio-player__status">Samples will be added here shortly.</p>
    </>
  )}
</div>

<script>
  function initialisePlayers() {
    const time = (seconds: number) => {
      const total = Number.isFinite(seconds) ? Math.floor(seconds) : 0;
      return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
    };
    document.querySelectorAll<HTMLElement>('[data-audio-player]').forEach((player) => {
      if (player.dataset.ready) return;
      player.dataset.ready = 'true';
      const audio = player.querySelector('audio');
      if (!audio) return;
      const controls = player.querySelector<HTMLElement>('[data-controls]')!;
      const play = player.querySelector<HTMLButtonElement>('[data-play]')!;
      const seek = player.querySelector<HTMLInputElement>('[data-seek]')!;
      const status = player.querySelector<HTMLElement>('[data-audio-status]')!;
      const elapsed = player.querySelector<HTMLElement>('[data-elapsed]')!;
      const duration = player.querySelector<HTMLElement>('[data-duration]')!;
      const playIcon = player.querySelector<SVGElement>('[data-play-icon]')!;
      const pauseIcon = player.querySelector<SVGElement>('[data-pause-icon]')!;
      audio.controls = false;
      controls.hidden = false;
      const update = () => {
        elapsed.textContent = time(audio.currentTime);
        duration.textContent = time(audio.duration);
        seek.value = String(audio.currentTime);
        seek.setAttribute('aria-valuetext', `${time(audio.currentTime)} of ${time(audio.duration)}`);
        play.setAttribute('aria-label', `${audio.paused ? 'Play' : 'Pause'} ${play.dataset.title}`);
        playIcon.toggleAttribute('hidden', !audio.paused);
        pauseIcon.toggleAttribute('hidden', audio.paused);
      };
      const loaded = () => {
        if (!Number.isFinite(audio.duration) || audio.duration <= 0) return;
        seek.max = String(audio.duration);
        seek.disabled = false;
        play.disabled = false;
        update();
      };
      audio.addEventListener('loadedmetadata', loaded);
      audio.addEventListener('durationchange', loaded);
      audio.addEventListener('timeupdate', update);
      audio.addEventListener('play', update);
      audio.addEventListener('pause', update);
      audio.addEventListener('ended', update);
      audio.addEventListener('error', () => {
        status.textContent = 'This sample could not load. Please try again later or enquire for a custom audition.';
        play.disabled = true;
        seek.disabled = true;
      });
      play.addEventListener('click', async () => {
        if (!audio.paused) { audio.pause(); return; }
        document.querySelectorAll('audio').forEach((other) => { if (other !== audio) other.pause(); });
        try { await audio.play(); status.textContent = ''; }
        catch { status.textContent = 'Playback could not start. Please try again.'; }
      });
      seek.addEventListener('input', () => { audio.currentTime = Number(seek.value); update(); });
      loaded();
      update();
    });
  }
  initialisePlayers();
  document.addEventListener('astro:page-load', initialisePlayers);
  document.addEventListener('astro:before-swap', () => document.querySelectorAll('audio').forEach((audio) => audio.pause()));
</script>

<style>
  .audio-player { width: 100%; padding: var(--s-4); background: var(--coconut); border: var(--border); }
  .audio-player__heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--s-2); margin-bottom: var(--s-3); }
  .audio-player__heading p { font-weight: 500; }
  .audio-player__heading span { font-size: var(--t-small); color: var(--ink-soft); }
  .audio-player__controls { display: flex; align-items: center; gap: var(--s-3); min-height: var(--s-7); }
  .audio-player__controls[hidden] { display: none; }
  .audio-player__play { min-width: 44px; height: 44px; display: grid; place-items: center; color: var(--clay-ink); }
  input { flex: 1; width: 100%; min-width: 0; accent-color: var(--clay-ink); min-height: 44px; }
  .audio-player__time { font-size: var(--t-small); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .audio-player__status { font-size: var(--t-small); color: var(--ink-soft); margin-top: var(--s-2); }
  .audio-player__status:empty { display: none; }
  button:disabled, input:disabled { opacity: .45; cursor: not-allowed; }
  audio { width: 100%; }
  [hidden] { display: none !important; }
</style>
