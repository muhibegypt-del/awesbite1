---
import Base from '../layouts/Base.astro';
import SectionMarker from './SectionMarker.astro';
import PillarCards from './PillarCards.astro';
import Button from './Button.astro';
import global from '../content/global.json';
import site from '../content/site.json';
interface Props { brandTreatment?: 'large' | 'current' }
const { brandTreatment } = Astro.props;
const { hub, about, credentials } = site;

/* The hub had no photograph at all: a 96px headline sat alone in an empty
   field, and the first image a visitor met was 1,400px down the page. Both
   placements below reuse an asset and its existing alt text from site.json
   rather than introducing new ones.

   The portrait carries the hero because it is the only frame where she is
   looking out of it — the right register for a first meeting. The manuscript
   frame is the one photograph on the site that is about texture rather than
   about a person, so it belongs to the section that explains the name, where
   it also breaks up the longest unbroken run of prose on the page. */
const narration = site.services.find((service) => service.id === 'narration')!;
const repurposing = site.services.find((service) => service.id === 'repurposing')!;
---

<Base title={global.meta.title} bare noindex={!!brandTreatment}>
  {brandTreatment && <aside class="review-notice container">
    <p>Brand treatment {brandTreatment === 'large' ? 'A — enlarged' : 'B — current size'}. For review, not a final choice.</p>
    <a href="/review/brand-options">Compare both options</a>
  </aside>}

  <section class="page-hero hero">
    <div class="container editorial">
      <div class="hero__copy stack">
        {brandTreatment && <p class:list={['brand-treatment', { 'brand-treatment--large': brandTreatment === 'large' }]}>
          a <em>textured</em> word
        </p>}
        <p class="hero__eyebrow">{site.brand.triad}</p>
        <h1 class="hero__headline optical-hang">{hub.headline}</h1>
        <p class="hero__sub">{hub.sub}</p>
      </div>

      <figure class="hero__media" style={`--image-position: ${narration.imagePosition}`}>
        <img
          src={narration.image}
          alt={narration.imageAlt}
          width="2200"
          height="1466"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section band" aria-labelledby="pillars-heading">
    <div class="container editorial">
      <SectionMarker label={hub.markers.pillars} class="editorial-aside" />
      <div class="editorial-full stack">
        <h2 id="pillars-heading">{hub.pillarsHeading}</h2>
        <p class="t-lead">{hub.pillarsLine}</p>
        <PillarCards full />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="authority-heading">
    <div class="container editorial">
      <SectionMarker label={hub.markers.authority} class="editorial-aside" />
      <div class="editorial-full split">
        <div class="frame frame--portrait">
          <img src={about.portrait} alt={about.portraitAlt} width="2200" height="1466" loading="lazy" decoding="async" />
        </div>
        <div class="stack">
          <h2 id="authority-heading">{hub.authorityHeading}</h2>
          {hub.authorityParagraphs.map((line) => <p class="t-body">{line}</p>)}
          <a class="link-rule" href={hub.authorityLink.href}>{hub.authorityLink.label} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <ul class="credentials editorial-full" role="list">
        {credentials.map((credential) => <li class="credentials__item">
          <span class="credentials__qualification">{credential.qualification}</span>
          <span class="credentials__body">{credential.body}</span>
        </li>)}
      </ul>
    </div>
  </section>

  <section class="section band" aria-labelledby="meaning-heading">
    <div class="container editorial">
      <SectionMarker label={hub.markers.name} class="editorial-aside" />
      <div class="editorial-full meaning-layout">
        <h2 id="meaning-heading">{hub.name.line}<br />{hub.name.lead} <em>{hub.name.emphasis}</em></h2>
        <div class="stack">
          <p class="t-lead">{hub.name.lede}</p>
          <p class="t-body">{hub.name.mission}</p>
        </div>
      </div>
      <figure
        class="band-media editorial-full"
        style={`--image-position: ${repurposing.imagePosition}`}
      >
        <img
          src={repurposing.image}
          alt={repurposing.imageAlt}
          width="2200"
          height="1466"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="content-heading">
    <div class="container editorial">
      <SectionMarker label={hub.markers.content} class="editorial-aside" />
      <div class="editorial-full stack">
        <h2 id="content-heading">{hub.contentHeading}</h2>
        <p class="t-lead">{about.reflectionBody}</p>
        <a class="link-rule" href={hub.contentLink.href}>{hub.contentLink.label} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="hub-close">
    <div class="container editorial">
      <SectionMarker label={hub.markers.close} class="editorial-aside" />
      <div class="editorial-full stack">
        <h2 id="hub-close">{site.contact.heading}</h2>
        <p class="t-lead">{site.contact.line}</p>
        <Button variant="primary" href={global.nav.cta.href}>{global.nav.cta.label}</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  /* Headline and photograph share one row, on the same six/four split the
     service pages already use, so the hub does not introduce a second hero
     pattern. Below 1280px the editorial grid collapses and the two stack,
     again matching the spokes. */

  .hero__copy {
    gap: var(--s-5);
    align-content: center;
  }

  .hero__eyebrow {
    width: 100%;
    max-inline-size: none;
    padding-block-end: var(--s-4);
    border-bottom: 1px solid var(--rule-strong);
    font-family: var(--font-display);
    font-size: var(--t-lead);
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: var(--track-lead);
    color: var(--ink-soft);
  }

  /* --t-display, not --t-hero: at 96px this headline broke every four or
     five characters once the photograph took the outer four columns. */
  .hero__headline {
    font-family: var(--font-display);
    font-size: var(--t-display);
    font-weight: 400;
    line-height: var(--lh-h1);
    letter-spacing: var(--track-display);
    max-inline-size: var(--measure-hero);
    text-wrap: balance;
  }

  .hero__sub {
    font-size: var(--t-lead);
    line-height: var(--lh-lead);
    letter-spacing: var(--track-lead);
    color: var(--ink-soft);
    max-inline-size: var(--measure-lead);
  }

  .hero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--coconut);
  }

  .hero__media::after {
    content: '';
    position: absolute;
    inset: var(--s-2);
    border: var(--border);
    pointer-events: none;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--image-position, center);
  }

  /* The editorial grid only exists from 1280px, so the pairing is rebuilt
     locally for tablets. Without it the photograph ran the full 738px width
     at 4:3 and stood taller than the headline beside it. */
  @media (min-width: 768px) and (max-width: 1279px) {
    .hero .editorial {
      grid-template-columns: 7fr 5fr;
      column-gap: var(--s-7);
      align-items: center;
    }

    .hero__copy { grid-column: 1; }

    .hero__media {
      grid-column: 2;
      aspect-ratio: 4 / 5;
    }
  }

  @media (min-width: 1280px) {
    .hero .hero__copy {
      grid-column: 3 / 9;
      grid-row: 1;
    }

    .hero__media {
      grid-column: 9 / -1;
      grid-row: 1;
      aspect-ratio: 4 / 5;
    }
  }

  /* ---- The name ---- */

  .meaning-layout { display: grid; gap: var(--s-7); }
  .meaning-layout h2 { max-inline-size: 15ch; }
  .band-media { margin-block-start: var(--s-8); }

  /* ---- Brand review harness (noindex pages only) ---- */

  .brand-treatment { font: 400 var(--t-h3)/1.1 var(--font-display); max-inline-size: none; }
  .brand-treatment--large { font-size: var(--t-hero); }
  .brand-treatment em { color: var(--clay-ink); }
  .review-notice { padding-block: var(--s-4); font-size: var(--t-small); border-bottom: var(--border); }

  @media (min-width: 768px) { .meaning-layout { grid-template-columns: 4fr 6fr; } }
</style>
