---
/**
 * HOME sections — hero, service selector, about strip, services grid.
 * Brief §6.1.1 to §6.1.4. Slot map HOME-01 to HOME-09.
 *
 * Extracted from index.astro so /variants can render the same markup three
 * times under different accent tokens. Nothing here is variant-aware.
 */
import SectionMarker from '../components/SectionMarker.astro';
import Button from '../components/Button.astro';
import defaultContent from '../content/home.json';

interface Props {
  /**
   * Namespaces the selector's element ids. /variants renders this component
   * three times on one page, and duplicate ids would break aria-controls and
   * silently wire every tablist to the first panel set.
   */
  idPrefix?: string;
  /**
   * Copy source. Defaults to home.json, the placeholder build. /preview
   * passes home.preview.json, which carries the draft wording.
   */
  content?: typeof defaultContent;
  /**
   * Whether an unfilled image slot announces itself with its slot-map
   * placeholder. True on the placeholder build so a staging walkthrough is a
   * content checklist; false on /preview, where a client is looking at the
   * design rather than auditing what is outstanding.
   */
  showImagePlaceholders?: boolean;
}

const {
  idPrefix = '',
  content = defaultContent,
  showImagePlaceholders = true,
} = Astro.props;

const { hero, selector, about, services: grid } = content;

/** Copy slots accept a string or an array of paragraphs. */
const paragraphs = (value: string | string[]) =>
  Array.isArray(value) ? value : [value];
const { sentence, services } = selector;

/**
 * Slot-map placeholders render as mono chips in --clay-ink, not at the
 * slot's real type size — a 96px hero placeholder is unreadable and tells
 * you nothing about the layout. Once Aneesa's copy replaces the bracketed
 * string, the slot picks up its proper scale with no code change.
 */
const isPlaceholder = (value: string) => value.trimStart().startsWith('[');
---

  <section class="hero">
    <div class="container editorial hero__grid">
      <SectionMarker label={hero.marker} class="editorial-aside" />

      <div class="hero__type">
        <h1 class={isPlaceholder(hero.headline) ? 'placeholder' : 'hero__headline'}>
          {hero.headline}
        </h1>
        {
          paragraphs(hero.subhead).map((line) => (
            <p class={isPlaceholder(line) ? 'placeholder' : 'hero__subhead'}>{line}</p>
          ))
        }
      </div>

      <div class="editorial-wide selector" data-selector>
        {/* The sentence mirrors the tab labels, so it is decorative to
            assistive tech — the tabs and the panel carry the same meaning
            without the hover churn. Brief §6.1.2. */}
        <p class="selector__sentence" aria-hidden="true">
          {/* The blanks are underscored spans, not ▁ characters — U+2581 is
              outside the latin and latin-ext subsets we ship, so it would
              render from a fallback face. A border-bottom is also what the
              brief actually asks for. */}
          <span class="selector__sentence-desktop">
            {sentence.lead}{' '}
            <span class="selector__blank selector__blank--short" data-blank="number"></span>
            {' '}{sentence.connector}{' '}
            <span class="selector__blank selector__blank--long" data-blank="completion"></span>
          </span>
          <span class="selector__sentence-mobile">{sentence.mobile}</span>
        </p>

        <div class="selector__tabs" role="tablist" aria-label="Services">
          {
            services.map((service, i) => (
              <button
                class="selector__tab"
                type="button"
                role="tab"
                id={`${idPrefix}tab-${service.id}`}
                aria-controls={`${idPrefix}panel-${service.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-service={service.id}
                data-number={service.number}
                data-completion={service.completion}
              >
                [{service.number} // {service.name}]
              </button>
            ))
          }
        </div>

        <div class="selector__panels">
          {
            services.map((service, i) => (
              <div
                class="panel"
                role="tabpanel"
                id={`${idPrefix}panel-${service.id}`}
                aria-labelledby={`${idPrefix}tab-${service.id}`}
                data-panel={service.id}
                aria-hidden={i === 0 ? undefined : 'true'}
                inert={i === 0 ? undefined : true}
              >
                {/* HOME-04. No textures shot yet, so the slot-map fallback
                    ships: a flat --coconut field at the panel's 16:6. */}
                <div class="panel__texture">
                  {!service.image && showImagePlaceholders && (
                    <p class="placeholder">{service.imagePlaceholder}</p>
                  )}
                  <div class="panel__body">
                    {/* Display-face copy once written. Brief §6.1.2. */}
                    <p class={isPlaceholder(service.caption) ? 'placeholder' : 'panel__caption'}>
                      {service.caption}
                    </p>
                    <a class="panel__link" href={service.link.href}>
                      {service.link.label} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section about">
    <div class="container editorial about__grid">
      {/* Rendered twice and swapped with display:none rather than moved,
          so only one is ever in the accessibility tree. Gutter above
          1280px, inline above the heading below it. */}
      <SectionMarker label={about.marker} class="editorial-aside about__marker-gutter" />

      <div class="about__content">
        {/* HOME-06. No portrait shot yet, so the frame ships empty: a 4:5
            --coconut field with the 1px inset rule 8px in from the edge. */}
        <div class="about__media">
          <div class="portrait">
            {!about.portrait && showImagePlaceholders && (
              <p class="placeholder">{about.portraitPlaceholder}</p>
            )}
          </div>
        </div>

        <div class="about__text">
          <SectionMarker label={about.marker} class="about__marker-inline" />

          {
            isPlaceholder(about.heading) ? (
              <p class="placeholder">{about.heading}</p>
            ) : (
              <h2>{about.heading}</h2>
            )
          }

          {
            paragraphs(about.paragraphs).map((line) => (
              <p class={isPlaceholder(line) ? 'placeholder' : 't-body'}>{line}</p>
            ))
          }
        </div>

        {/* Credential row and the link that follows it span the full content
            width beneath both columns. Keeping them inside the 7-column text
            block squeezed four credentials into ~100px each and wrapped every
            label. The brief's order — copy, credentials, link — is preserved. */}
        <div class="about__below">
          {/* HOME-08. OWNER: DRAFT EXISTS — all four are confirmed in her
              notes, so the real wording ships and she confirms it. */}
          <ul class="credentials" role="list">
            {
              about.credentials.map((credential) => (
                <li class="credentials__item">
                  <span class="credentials__qualification">{credential.qualification}</span>
                  <span class="credentials__body">{credential.body}</span>
                </li>
              ))
            }
          </ul>

          <Button variant="quiet" href={about.link.href}>
            {about.link.label}&nbsp;<span aria-hidden="true">→</span>
          </Button>
        </div>
      </div>
    </div>
  </section>

  <section class="section services">
    <div class="container editorial services__grid">
      <SectionMarker label={grid.marker} class="editorial-aside services__marker-gutter" />

      <div class="services__columns">
        <SectionMarker label={grid.marker} class="services__marker-inline" />

        {
          grid.items.map((item) => (
            <article class="service">
              <p class="service__tag">[{item.number} // {item.name}]</p>

              <h3 class="service__title">{item.title}</h3>

              <p class={isPlaceholder(item.oneLiner) ? 'placeholder' : 'service__one-liner'}>
                {item.oneLiner}
              </p>

              {/* No bullet glyphs — a 12px --rule dash instead. Brief §6.1.4. */}
              <ul class="service__bullets" role="list">
                {item.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>

              {/* HOME-09. Must never be blank or filler — if prices are not
                  ready at launch the line reads PRICING ON ENQUIRY. */}
              <p class={isPlaceholder(item.price) ? 'placeholder' : 'service__price'}>
                {item.price}
              </p>

              <a class="service__cta" href={item.link.href}>
                {item.link.label}&nbsp;<span class="service__arrow" aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

<style>
  /* Never 100vh — a sliver of the next section invites the scroll.
     Brief §6.1.1. */
  .hero {
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding-block: var(--s-9);
  }

  .hero__grid {
    width: 100%;
    row-gap: var(--s-8);
  }

  .hero__type {
    display: grid;
    gap: var(--s-5);
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: var(--t-hero);
    font-weight: 300;
    line-height: 0.94;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  /* Subhead sits in columns 3–7, not 3–9. Brief §6.1.1. */
  .hero__subhead {
    font-size: var(--t-lead);
    line-height: 1.6;
    color: var(--ink-soft);
    max-inline-size: 52ch;
  }

  @media (min-width: 1280px) {
    .hero__type > .hero__subhead {
      max-inline-size: 44ch;
    }
  }

  /* ---- Selector ---- */

  .selector {
    display: grid;
    gap: var(--s-5);
  }

  .selector__sentence {
    margin: 0;
    max-inline-size: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: 1.6;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--ink-soft);
    /* Holds its box while the blanks fill, so the buttons never shift. */
    min-block-size: calc(var(--t-mono) * 1.6 * 3);
  }

  .selector__blank {
    display: inline-block;
    color: var(--clay-ink);
    border-bottom: 1px solid var(--clay);
    /* The rule sits on the baseline rather than under the descenders. */
    vertical-align: baseline;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .selector__blank--short {
    min-inline-size: 4ch;
  }

  .selector__blank--long {
    min-inline-size: 16ch;
  }

  /* Filled blanks lose the rule — the words replace it. */
  .selector__blank.is-filled {
    border-bottom-color: transparent;
    min-inline-size: 0;
  }

  .selector__sentence-mobile {
    display: none;
  }

  @media (max-width: 767px) {
    .selector__sentence-desktop {
      display: none;
    }

    .selector__sentence-mobile {
      display: inline;
    }

    .selector__sentence {
      min-block-size: 0;
    }
  }

  .selector__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  /* Padding is 14px 20px exactly, from the component spec in brief §6.1.2.
     Those two values are off the §4.2 spacing scale; the component spec is
     the more specific instruction, so it wins here and only here. */
  .selector__tab {
    padding: 14px 20px;
    font-family: var(--font-mono);
    font-size: var(--t-mono-lg);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: var(--track-mono-lg);
    text-transform: uppercase;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .selector__tab:hover {
    color: var(--ink);
    border-color: var(--clay);
    background: color-mix(in srgb, var(--clay) 6%, transparent);
  }

  .selector__tab:focus-visible {
    color: var(--ink);
    background: color-mix(in srgb, var(--clay) 6%, transparent);
  }

  .selector__tab[aria-selected='true'] {
    color: var(--paper);
    background: var(--clay-ink);
    border-color: var(--clay-ink);
  }

  @media (max-width: 767px) {
    .selector__tabs {
      flex-direction: column;
      gap: var(--s-2);
    }

    .selector__tab {
      width: 100%;
      text-align: center;
    }
  }

  /* ---- Texture panel ---- */

  .selector__panels {
    display: grid;
  }

  /* All three stack in one cell so they can cross-fade. */
  .panel {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease);
    pointer-events: none;
  }

  .panel.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* The unshot image slot announces itself like every other unwritten slot,
     so a staging walkthrough is a complete content checklist. */
  .panel__texture {
    aspect-ratio: 16 / 6;
    background: var(--coconut);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-5);
  }

  .panel__body {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    /* Pinned to the bottom whether or not the image placeholder is above it.
       space-between alone would float it to the top when it is the only
       child, which is the case on /preview. */
    margin-block-start: auto;
  }

  /* One line of display-face copy. Brief §6.1.2. --ink on --coconut is
     10.46, so the caption holds up against the texture field. */
  .panel__caption {
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 300;
    font-style: italic;
    line-height: 1.3;
    color: var(--ink);
    max-inline-size: 34ch;
  }

  .panel__link {
    font-family: var(--font-body);
    font-size: var(--t-small);
    text-decoration: none;
    color: var(--clay-ink);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--s-1);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .panel__link:hover {
    color: var(--ink);
    border-bottom-color: var(--clay);
  }

  @media (max-width: 767px) {
    .panel__texture {
      /* 16:6 is unreadable at 350px wide once the caption sits inside it. */
      aspect-ratio: auto;
      min-block-size: 220px;
      padding: var(--s-4);
    }
  }

  /* ---- About strip ---- */

  /* The 5/7 split is of the content area, not of the whole 12-column grid,
     so § ABOUT lines up with § 01 in the hero rather than sitting 12px off. */
  .about__content {
    display: grid;
    gap: var(--s-7);
  }

  @media (min-width: 768px) {
    .about__content {
      grid-template-columns: 5fr 7fr;
      gap: var(--s-8);
      align-items: start;
    }

    .about__below {
      grid-column: 1 / -1;
    }
  }

  .about__below {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }

  @media (min-width: 1280px) {
    .about__grid > .about__content {
      grid-column: 3 / -1;
    }
  }

  /* :global because these classes land on SectionMarker's root element,
     which carries its own scope id and not this page's. Anchored to
     .about__grid so the rule stays contained to this section. */
  .about__grid :global(.about__marker-gutter) {
    display: none;
  }

  @media (min-width: 1280px) {
    .about__grid :global(.about__marker-gutter) {
      display: flex;
    }

    .about__grid :global(.about__marker-inline) {
      display: none;
    }
  }

  .about__text {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }

  /* Portrait frame: 4:5, hard corners, with the 1px rule set 8px inside the
     image edge for a framed-print effect. Brief §6.1.3. */
  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--coconut);
    border-radius: var(--radius-none);
    display: flex;
    align-items: flex-start;
    /* Clears the inset rule by one step of the scale. */
    padding: var(--s-4);
  }

  .portrait::after {
    content: '';
    position: absolute;
    inset: var(--s-2);
    border: var(--border);
    pointer-events: none;
  }

  /* ---- Credential row ---- */

  .credentials {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-5) 0;
    width: 100%;
    margin-block: var(--s-2);
  }

  @media (min-width: 1024px) {
    .credentials {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .credentials__item {
    display: grid;
    gap: var(--s-1);
    padding-inline: var(--s-4);
  }

  /* Hairline verticals between items — 2×2 here, so only the second of each
     pair carries one, and the first of each pair loses its left padding so
     both rows start on the same edge. No icons, no badges. */
  .credentials__item:nth-child(odd) {
    padding-inline-start: 0;
  }

  .credentials__item:nth-child(even) {
    border-inline-start: var(--border);
  }

  @media (min-width: 1024px) {
    /* One row of four: every item but the first carries a vertical. */
    .credentials__item {
      padding-inline-start: var(--s-4);
      border-inline-start: var(--border);
    }

    .credentials__item:first-child {
      padding-inline-start: 0;
      border-inline-start: none;
    }
  }

  .credentials__qualification {
    font-family: var(--font-body);
    font-size: var(--t-small);
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
  }

  .credentials__body {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: 1.4;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* ---- Services grid ---- */

  @media (min-width: 1280px) {
    .services__grid > .services__columns {
      grid-column: 3 / -1;
    }
  }

  .services__grid :global(.services__marker-gutter) {
    display: none;
  }

  @media (min-width: 1280px) {
    .services__grid :global(.services__marker-gutter) {
      display: flex;
    }

    .services__grid :global(.services__marker-inline) {
      display: none;
    }
  }

  .services__columns {
    display: grid;
    gap: var(--s-7);
  }

  /* No card borders. Separation is a hairline vertical between columns plus
     48px of internal padding. Brief §6.1.4. */
  @media (min-width: 768px) {
    .services__columns {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }

    .services__columns :global(.services__marker-inline) {
      grid-column: 1 / -1;
      margin-block-end: var(--s-6);
    }

    .service {
      padding-inline: var(--s-6);
      border-inline-start: var(--border);
    }

    .service:first-of-type {
      padding-inline-start: 0;
      border-inline-start: none;
    }

    .service:last-of-type {
      padding-inline-end: 0;
    }
  }

  .service {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    align-content: start;
  }

  .service__tag {
    margin: 0;
    max-inline-size: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono-lg);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: var(--track-mono-lg);
    text-transform: uppercase;
    color: var(--clay-ink);
  }

  .service__title {
    font-family: var(--font-body);
    font-size: var(--t-h3);
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
  }

  .service__one-liner {
    font-size: var(--t-body);
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .service__bullets {
    list-style: none;
    display: grid;
    gap: var(--s-2);
    margin-block: var(--s-2);
  }

  .service__bullets li {
    display: grid;
    grid-template-columns: 12px 1fr;
    align-items: baseline;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: 1.4;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* A 12px hairline dash standing in for the bullet glyph. */
  .service__bullets li::before {
    content: '';
    inline-size: 12px;
    block-size: 1px;
    background: var(--rule);
    /* Lifts the rule off the baseline to sit against the lowercase x-height. */
    transform: translateY(-0.3em);
  }

  .service__price {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: 1.4;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--clay-ink);
  }

  .service__cta {
    font-family: var(--font-body);
    font-size: var(--t-small);
    text-decoration: none;
    color: var(--clay-ink);
    border-bottom: 1px solid var(--rule);
    padding-bottom: var(--s-1);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .service__cta:hover {
    color: var(--ink);
    border-bottom-color: var(--clay);
  }

  .service__arrow {
    display: inline-block;
    transition: transform var(--dur-fast) var(--ease);
  }

  .service__cta:hover .service__arrow,
  .service__cta:focus-visible .service__arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .service__arrow {
      transition: none;
    }

    .service__cta:hover .service__arrow,
    .service__cta:focus-visible .service__arrow {
      transform: none;
    }
  }
</style>

<script>
  /* Every selector on the page gets wired, not just the first — /variants
     renders three of them and a single querySelector would leave two dead. */
  for (const root of document.querySelectorAll<HTMLElement>('[data-selector]')) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const blankNumber = root.querySelector<HTMLElement>('[data-blank="number"]');
    const blankCompletion = root.querySelector<HTMLElement>('[data-blank="completion"]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const TYPE_MS = 220;

    let typing = 0;

    /** Shows a panel visually. Selection state is handled separately so the
        pointer can preview a panel without changing which tab is selected. */
    function show(id: string) {
      for (const panel of panels) {
        panel.classList.toggle('is-visible', panel.dataset.panel === id);
      }
    }

    function selectedId(): string {
      const current = tabs.find((t) => t.getAttribute('aria-selected') === 'true');
      return current?.dataset.service ?? tabs[0].dataset.service!;
    }

    /** Types the two blanks in over 220ms. No cursor, no blink. */
    function fill(tab: HTMLButtonElement) {
      if (!blankNumber || !blankCompletion) return;

      cancelAnimationFrame(typing);
      const number = tab.dataset.number ?? '';
      const completion = tab.dataset.completion ?? '';
      blankNumber.textContent = number;
      blankNumber.classList.add('is-filled');
      blankCompletion.classList.add('is-filled');

      if (reduceMotion.matches) {
        blankCompletion.textContent = completion;
        return;
      }

      const start = performance.now();
      const step = (now: number) => {
        const progress = Math.min((now - start) / TYPE_MS, 1);
        blankCompletion.textContent = completion.slice(
          0,
          Math.ceil(completion.length * progress)
        );
        if (progress < 1) typing = requestAnimationFrame(step);
      };
      typing = requestAnimationFrame(step);
    }

    /** Back to PRESS ▁▁ IF YOU ▁▁. The resting state in brief §6.1.2. */
    function clear() {
      if (!blankNumber || !blankCompletion) return;
      cancelAnimationFrame(typing);
      blankNumber.textContent = '';
      blankCompletion.textContent = '';
      blankNumber.classList.remove('is-filled');
      blankCompletion.classList.remove('is-filled');
    }

    function select(id: string, { focus = false, updateHash = true } = {}) {
      for (const tab of tabs) {
        const isCurrent = tab.dataset.service === id;
        tab.setAttribute('aria-selected', String(isCurrent));
        tab.tabIndex = isCurrent ? 0 : -1;
        if (isCurrent && focus) tab.focus();
      }

      for (const panel of panels) {
        const isCurrent = panel.dataset.panel === id;
        panel.toggleAttribute('inert', !isCurrent);
        if (isCurrent) panel.removeAttribute('aria-hidden');
        else panel.setAttribute('aria-hidden', 'true');
      }

      show(id);

      if (updateHash) {
        // replaceState, not a hash assignment: no scroll jump, no history spam.
        history.replaceState(null, '', `#${id}`);
      }
    }

    for (const [i, tab] of tabs.entries()) {
      tab.addEventListener('click', () => select(tab.dataset.service!));

      // Hover previews the panel and fills the sentence. Brief §6.1.2.
      tab.addEventListener('pointerenter', () => {
        fill(tab);
        show(tab.dataset.service!);
      });
      tab.addEventListener('pointerleave', () => {
        clear();
        show(selectedId());
      });

      tab.addEventListener('focus', () => fill(tab));
      tab.addEventListener('blur', () => {
        clear();
        show(selectedId());
      });

      tab.addEventListener('keydown', (event) => {
        const keys: Record<string, number> = {
          ArrowLeft: i - 1,
          ArrowUp: i - 1,
          ArrowRight: i + 1,
          ArrowDown: i + 1,
          Home: 0,
          End: tabs.length - 1,
        };
        const next = keys[event.key];
        if (next === undefined) return;
        event.preventDefault();
        const wrapped = (next + tabs.length) % tabs.length;
        select(tabs[wrapped].dataset.service!, { focus: true });
      });
    }

    function fromHash() {
      const id = location.hash.replace('#', '');
      if (tabs.some((t) => t.dataset.service === id)) {
        select(id, { updateHash: false });
      }
    }

    // Deep links: #teach, #speak, #write.
    fromHash();
    window.addEventListener('hashchange', fromHash);

    show(selectedId());
  }
</script>
