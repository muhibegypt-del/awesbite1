---
interface NavChild { label: string; href: string }
interface NavItem { label: string; href: string; children?: NavChild[] }
interface Props { items: NavItem[]; currentPath: string }

const { items, currentPath } = Astro.props;
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<nav class="site-nav" aria-label="Primary" data-nav data-ready="true">
  <button class="menu-toggle" type="button" aria-expanded="false"
    aria-controls="primary-navigation" data-menu-toggle>
    <span>Menu</span><span class="chevron" aria-hidden="true"></span>
  </button>

  <ul class="nav-list" id="primary-navigation" role="list" data-nav-list>
    {items.map((item, index) => (
      <li class="nav-item">
        <div class="nav-topline">
          <a class="nav-link" href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          {item.children?.length && (
            <button class="submenu-toggle" type="button"
              aria-label={`Show ${item.label} links`} aria-expanded="false"
              aria-controls={`nav-submenu-${index}`} data-submenu-toggle>
              <span class="chevron" aria-hidden="true"></span>
            </button>
          )}
        </div>
        {item.children?.length && (
          <ul class="submenu" id={`nav-submenu-${index}`} role="list">
            {item.children.map((child) => <li><a href={child.href}>{child.label}</a></li>)}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<noscript>
  <style>
    @media (max-width: 1023px) {
      .site-nav .menu-toggle { display: none !important; }
      .site-nav .nav-list { display: grid !important; }
    }
  </style>
</noscript>

<script>
  function initialiseNavigation() {
    document.querySelectorAll<HTMLElement>('[data-nav]').forEach((nav) => {
      if (nav.dataset.bound === 'true') return;
      nav.dataset.bound = 'true';
      nav.dataset.ready = 'true';
      const menu = nav.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const toggles = nav.querySelectorAll<HTMLButtonElement>('[data-submenu-toggle]');
      const closeSubmenus = (except?: HTMLButtonElement) => {
        toggles.forEach((toggle) => {
          if (toggle !== except) toggle.setAttribute('aria-expanded', 'false');
        });
      };
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        if (!open) closeSubmenus();
      });
      toggles.forEach((toggle) => {
        toggle.addEventListener('click', () => {
          const open = toggle.getAttribute('aria-expanded') !== 'true';
          closeSubmenus(toggle);
          toggle.setAttribute('aria-expanded', String(open));
        });
      });
      nav.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        closeSubmenus();
        menu?.setAttribute('aria-expanded', 'false');
        menu?.focus();
      });
      document.addEventListener('click', (event) => {
        if (event.target instanceof Node && !nav.contains(event.target)) closeSubmenus();
      });
      nav.querySelector('[data-nav-list]')?.addEventListener('click', (event) => {
        if (event.target instanceof HTMLAnchorElement) menu?.setAttribute('aria-expanded', 'false');
      });
    });
  }
  initialiseNavigation();
  document.addEventListener('astro:page-load', initialiseNavigation);
</script>

<style>
  .site-nav { margin-left: auto; }
  .menu-toggle { display: none; }
  .nav-list { display: flex; align-items: center; gap: var(--s-5); list-style: none; }
  .nav-item { position: relative; }
  .nav-topline { display: flex; align-items: center; }
  .nav-link, .submenu a {
    font: var(--t-small)/1.4 var(--font-body);
    text-transform: lowercase;
    color: var(--ink);
  }
  .nav-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .nav-link:hover, .submenu a:hover { color: var(--clay-ink); }
  .nav-link[aria-current='page'] {
    color: var(--clay-ink);
    font-weight: 500;
    border-bottom-color: var(--clay);
  }
  .submenu-toggle {
    width: 44px;
    height: 44px;
    margin-right: -14px;
    border: 0;
    background: transparent;
    color: var(--ink);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .chevron {
    width: 8px;
    height: 8px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--dur-fast) var(--ease);
  }
  [aria-expanded='true'] > .chevron { transform: translateY(2px) rotate(225deg); }
  .submenu {
    display: none;
    position: absolute;
    z-index: 20;
    top: calc(100% + var(--s-2));
    left: 0;
    min-width: 12rem;
    padding: var(--s-2);
    list-style: none;
    background: var(--paper);
    border: var(--border);
  }
  .nav-topline:has(.submenu-toggle[aria-expanded='true']) + .submenu { display: grid; }
  .submenu a {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding-inline: var(--s-3);
    text-decoration: none;
  }
  @media (max-width: 1023px) {
    .site-nav { order: 3; width: 100%; margin-left: 0; }
    .site-nav[data-ready='true'] .menu-toggle {
      min-height: 44px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--ink);
      font: var(--t-small)/1.4 var(--font-body);
      text-transform: lowercase;
      cursor: pointer;
    }
    .nav-list {
      display: grid;
      gap: 0;
      align-items: stretch;
      padding-block: var(--s-2) var(--s-4);
      border-top: var(--border);
    }
    .site-nav[data-ready='true'] .nav-list { display: none; }
    .site-nav[data-ready='true'] .menu-toggle[aria-expanded='true'] + .nav-list { display: grid; }
    .nav-topline { justify-content: space-between; }
    .nav-link { flex: 1; }
    .submenu-toggle { margin-right: 0; }
    .submenu {
      position: static;
      min-width: 0;
      margin-bottom: var(--s-2);
      padding: 0 0 0 var(--s-4);
      border: 0;
      border-left: 1px solid var(--coconut);
      box-shadow: none;
      background: transparent;
    }
  }
</style>
