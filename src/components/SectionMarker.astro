---
/**
 * The mono marker in the wide left gutter, e.g. § SERVICES.
 *
 * Takes an `as` so a marker that titles an otherwise-unheaded section can be a
 * real heading. As a <p> it was invisible to heading navigation, which left
 * some pages with a single navigable heading below the h1.
 */
interface Props {
  label: string;
  as?: 'p' | 'h2' | 'h3';
  id?: string;
  class?: string;
}

const { label, as: Tag = 'p', id, class: className } = Astro.props;
const classes = ['marker', className].filter(Boolean).join(' ');
---

<Tag class={classes} id={id}>
  <span class="marker__sign" aria-hidden="true">§</span>{label}
</Tag>

<style>
  .marker {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    margin: 0;
    max-inline-size: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* --clay-ink, not --clay. --clay is 4.09:1 and CLAUDE.md forbids it below
     24px; this glyph renders at 12px on every section of every page. */
  .marker__sign {
    color: var(--clay-ink);
  }
</style>
