---
import links from '../content/content-links.json';
---
<aside class="library" aria-labelledby="library-heading">
  <div class="container library__inner">
    <h2 id="library-heading">Library</h2>
    <ul role="list">
      {links.library.map((link) => <li>{link.url
        ? <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="visually-hidden"> (opens in a new tab)</span></a>
        : <span class="library__pending">{link.label} <small>coming soon</small></span>}</li>)}
    </ul>
  </div>
</aside>
<style>
  .library { border-top: var(--border); padding-block: var(--s-5); }
  .library__inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-7); }
  h2 { font: 500 var(--t-small)/1.4 var(--font-body); }
  ul { display: flex; flex-wrap: wrap; gap: var(--s-5); }
  a, .library__pending { font-size: var(--t-small); }
  .library__pending { color: var(--ink-soft); }
  small { margin-left: var(--s-2); }
</style>
