---
/** The name, explained: the essay moment and the manuscript photograph. */
import site from '../../content/site.json';
import { smartQuotes as q } from './typeset.js';
const { hub } = site;
const repurposing = site.services.find((s) => s.id === 'repurposing')!;
---

<section class="sec essay" aria-label={hub.markers.name}>
  <div class="bleed">
    <p class="label essay__label">{hub.markers.name}</p>
    <p class="essay__lede">{q(hub.name.lede)}</p>
    <p class="essay__mission">{q(hub.name.mission)}</p>
  </div>
  <figure class="essay__photo">
    <img class="graded" src={repurposing.image} alt={repurposing.imageAlt} width="2200" height="1466" loading="lazy" decoding="async" />
  </figure>
</section>
