---
import Wordmark from './Wordmark.astro';
import global from '../../content/global.json';
const { footer } = global;
---

<footer class="ftr">
  <div class="bleed">
    <div class="ftr__brand">
      <Wordmark class="ftr__mark" />
      <p class="ftr__tagline">{footer.tagline}</p>
    </div>
    {footer.columns.map((column) => (
      <div class="ftr__col">
        <p class="label ftr__heading">{column.heading}</p>
        <ul role="list">
          {column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    ))}
    <p class="ftr__legal">{footer.legal}</p>
  </div>
</footer>
