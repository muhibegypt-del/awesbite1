---
/**
 * The voice portfolio before audio exists: one track list, each title with
 * its pending tag, the note once. When a track gains a src this row becomes
 * the player.
 */
import SectionHead from './SectionHead.astro';
import site from '../../content/site.json';
import tracks from '../../content/narration-tracks.json';
const narration = site.services.find((s) => s.id === 'narration')!;
---

<section class="sec tracks" aria-labelledby="tracks-heading">
  <div class="bleed">
    <SectionHead label={`${narration.number} — ${narration.tag}`} heading={narration.portfolioHeading} id="tracks-heading" />
    <ol class="tracks__list" role="list">
      {tracks.map((track) => (
        <li class="track">
          <span class="track__title">{track.title}</span>
          <span class="track__tag">{track.tag}</span>
        </li>
      ))}
    </ol>
    <p class="tracks__note">{narration.samplesPending}</p>
  </div>
</section>
