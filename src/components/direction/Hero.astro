---
/**
 * The hub's first screen. Same content in both directions; the composition
 * is set in directions.css by [data-direction].
 *
 * The brand line is the display element. The existing hub headline stays the
 * page's heading (search, screen readers, outline) and is set as the lead.
 * Every word comes from site.json / global.json.
 */
import PencilMark from './PencilMark.astro';
import { smartQuotes as q } from './typeset.js';
import site from '../../content/site.json';
import global from '../../content/global.json';
import directions from '../../content/directions.json';

interface Props {
  direction: 'a' | 'b';
  /** 'h1' on a real page; the collage demotes it so the page keeps one h1. */
  headingTag?: 'h1' | 'p';
}

const { direction, headingTag: Heading = 'h1' } = Astro.props;
const { hub, brand, about } = site;
const narration = site.services.find((s) => s.id === 'narration')!;

const teaching = site.services.find((s) => s.id === 'teaching')!;
const photos = {
  about: { src: about.portrait, alt: about.portraitAlt },
  narration: { src: narration.image, alt: narration.imageAlt },
  teaching: { src: teaching.image, alt: teaching.imageAlt },
};
const photo = photos[directions[direction].heroPhoto as keyof typeof photos];
---

<section class="hero" aria-labelledby="hero-heading">
  <p class="hero__runhead">{brand.triad}</p>

  <p class="hero__display">
    <span class="hero__line">{q(hub.name.line)}</span>
    <span class="hero__line">{q(hub.name.lead)} <PencilMark><em>{hub.name.emphasis}</em></PencilMark></span>
  </p>

  <div class="hero__copy">
    <Heading class="hero__h1" id="hero-heading">{hub.headline}</Heading>
    <p class="hero__sub">{hub.sub}</p>
    <div class="hero__actions">
      <a class="btn" href={global.nav.cta.href}>{global.nav.cta.label}</a>
      <a class="textlink" href="#services">{hub.pillarsHeading}</a>
    </div>
  </div>

  <figure class="hero__photo">
    <img class="graded" src={photo.src} alt={photo.alt} width="2200" height="1466" loading="eager" fetchpriority="high" decoding="async" />
  </figure>
</section>
