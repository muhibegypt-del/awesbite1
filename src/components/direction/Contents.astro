---
/**
 * The three services set as a contents page. One link per entry (on the
 * title), stretched over the entry so the whole entry is the target while
 * the accessible name stays short. Numerals are CSS counters, not copy.
 */
import SectionHead from './SectionHead.astro';
import site from '../../content/site.json';

const order = ['teaching', 'repurposing', 'narration'];
const services = [...site.services].sort((a, b) => order.indexOf(a.id) - order.indexOf(b.id));
const { hub } = site;
---

<section class="sec contents" id="services" aria-labelledby="contents-heading">
  <div class="bleed">
    <SectionHead label={hub.markers.pillars} heading={hub.pillarsHeading} lead={hub.pillarsLine} id="contents-heading" />
    <ol class="contents__list" role="list">
      {services.map((service) => (
        <li class="entry">
          <h3 class="entry__title"><a href={service.route}>{service.pillarCard.title}</a></h3>
          <p class="entry__line">{service.pillarCard.line}</p>
          <p class="entry__one">{service.oneLiner}</p>
          <p class="entry__who" aria-hidden="true">{service.audience} <span>→</span></p>
        </li>
      ))}
    </ol>
  </div>
</section>
