---
/**
 * Every photograph on the site: responsive AVIF and WebP from the source in
 * src/assets/images, graded into the palette (#duotone in Base.astro).
 * Content JSON keeps referring to images by their old public path.
 */
import { Picture } from 'astro:assets';
import { imageFor } from '../lib/images.js';

interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes?: string;
  eager?: boolean;
}

const { src, alt, class: className, sizes = '100vw', eager = false } = Astro.props;
const image = imageFor(src);
---

<Picture
  src={image}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="webp"
  widths={[480, 800, 1200, 1600, 2200]}
  sizes={sizes}
  class:list={['graded', className]}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
