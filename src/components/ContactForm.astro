---
/**
 * The enquiry form. It builds a ready-to-send email (there is no form
 * service on this host). The topic can be pre-selected from ?about=, so a
 * producer arriving from /narration does not have to notice a dropdown.
 * Errors are persistent and tied to their field, not a vanishing bubble.
 */
import site from '../content/site.json';
import global from '../content/global.json';

const { contact } = site;
---

<form class="form" name="enquiry" method="GET" action={`mailto:${global.contact.email}`} enctype="text/plain" data-email={global.contact.email} novalidate>
  <p class="small muted">{contact.optionalNote}</p>

  <div class="form__row">
    <div class="field">
      <label class="field__label" for="f-name">{contact.fields.name}</label>
      <input id="f-name" type="text" name="name" autocomplete="name" required aria-describedby="err-name" data-error-missing={contact.errors.name} />
      <span class="field__error" id="err-name" role="alert"></span>
    </div>
    <div class="field">
      <label class="field__label" for="f-email">{contact.fields.email}</label>
      <input id="f-email" type="email" name="email" autocomplete="email" required aria-describedby="err-email" data-error-missing={contact.errors.email} data-error-format={contact.errors.emailFormat} />
      <span class="field__error" id="err-email" role="alert"></span>
    </div>
  </div>

  <div class="form__row">
    <div class="field">
      <label class="field__label" for="f-topic">{contact.fields.topic}</label>
      <select id="f-topic" name="topic" required aria-describedby="err-topic" data-error-missing={contact.errors.topic}>
        <option value="">{contact.topicPlaceholder}</option>
        {contact.topics.map((topic) => <option value={topic}>{topic}</option>)}
      </select>
      <span class="field__error" id="err-topic" role="alert"></span>
    </div>
    <div class="field">
      <label class="field__label" for="f-deadline">{contact.fields.deadline}</label>
      <input id="f-deadline" type="text" name="deadline" />
    </div>
  </div>

  <div class="field">
    <label class="field__label" for="f-message">{contact.fields.message}</label>
    <textarea id="f-message" name="message" rows="5" placeholder={contact.placeholder} required aria-describedby="err-message" data-error-missing={contact.errors.message}></textarea>
    <span class="field__error" id="err-message" role="alert"></span>
  </div>

  <div class="form__actions">
    <button class="btn" type="submit" data-submit data-sending={contact.submitting}><span class="btn__label">{contact.submit}</span></button>
    <p class="small muted">{contact.response}</p>
  </div>
</form>

<script>
  function initialiseEnquiryForm() {
    const form = document.querySelector<HTMLFormElement>('form[name="enquiry"]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    const topic = form.elements.namedItem('topic');
    const requestedTopic = new URLSearchParams(window.location.search).get('about');

    if (topic instanceof HTMLSelectElement && requestedTopic) {
      const isKnownTopic = Array.from(topic.options).some((option) => option.value === requestedTopic);
      if (isKnownTopic) topic.value = requestedTopic;
    }

    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const fields = Array.from(form.querySelectorAll<Field>('[data-error-missing]'));

    const messageFor = (field: Field) => {
      if (field.validity.valueMissing) return field.dataset.errorMissing ?? '';
      if (field.validity.typeMismatch) return field.dataset.errorFormat ?? '';
      return '';
    };

    const show = (field: Field, message: string) => {
      const id = field.getAttribute('aria-describedby');
      const target = id ? document.getElementById(id) : null;
      if (target) target.textContent = message;
      field.setAttribute('aria-invalid', message ? 'true' : 'false');
    };

    for (const field of fields) {
      field.addEventListener('input', () => show(field, ''));
      field.addEventListener('change', () => show(field, ''));
    }

    form.addEventListener('submit', (event) => {
      let firstInvalid: Field | null = null;

      for (const field of fields) {
        const message = field.checkValidity() ? '' : messageFor(field);
        show(field, message);
        if (message && !firstInvalid) firstInvalid = field;
      }

      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
        return;
      }

      event.preventDefault();
      const button = form.querySelector<HTMLElement>('[data-submit]');
      if (button) {
        const label = button.querySelector('.btn__label') ?? button;
        label.textContent = button.dataset.sending ?? label.textContent;
      }
      const value = (name: string) => {
        const field = form.elements.namedItem(name);
        return field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement ? field.value : '';
      };
      const subject = `Website enquiry: ${value('topic')}`;
      const body = [
        `Name: ${value('name')}`,
        `Email: ${value('email')}`,
        `Topic: ${value('topic')}`,
        `Deadline: ${value('deadline') || 'Not specified'}`,
        '',
        value('message'),
      ].join('\n');
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    });
  }
  initialiseEnquiryForm();
</script>
