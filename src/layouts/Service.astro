---
/**
 * A service page (spoke). One service, one audience, its own argument and
 * its own call to action. The three share this template; the JSON decides
 * which parts a service has. There are no branches on the service id: a
 * section renders when its content (or its flag) exists.
 */
import Base from './Base.astro';
import Masthead from '../components/Masthead.astro';
import SectionHead from '../components/SectionHead.astro';
import Note from '../components/Note.astro';
import PriceList from '../components/PriceList.astro';
import TrackList from '../components/TrackList.astro';
import ServiceList from '../components/ServiceList.astro';
import OfferCards from '../components/OfferCards.astro';
import { q } from '../lib/typeset.js';
import site from '../content/site.json';
import pages from '../content/pages.json';
import global from '../content/global.json';
import offerings from '../content/offerings.json';

interface Props { id: 'teaching' | 'repurposing' | 'narration' }
const { id } = Astro.props;
const service: Record<string, any> = site.services.find((s) => s.id === id)!;
const meta = pages.meta[id];
const labels = pages.services;

/* A paragraph may carry one link, named in the JSON by its exact text. */
const linkIn = (body: string, link?: { text: string; href: string }) => {
  if (!link || !body.includes(link.text)) return null;
  const [before, after] = body.split(link.text);
  return { before, after, ...link };
};
const background = service.background && linkIn(service.background.body, service.backgroundLink);
const hasDetails = service.studio || service.examples?.length || service.background;
/* Her offers (client revisions, November 2026): cards here, a page each. */
const offerSet: Record<string, any> | null = service.offers ? (offerings as Record<string, any>)[service.offers] : null;
const types = offerSet?.types;
const unsureHref = `/contact?about=${encodeURIComponent(offerSet?.topic ?? '')}`;
---

<Base title={meta.title} description={meta.description}>
  <Masthead
    runhead={`${service.number} — ${service.tag}`}
    runheadHidden
    title={service.plain}
    audience={service.audience}
    image={service.image}
    imageAlt={service.imageAlt}
  >
    <p slot="side" class="lead masthead__pillar"><em>{service.pillar}</em></p>
    <Fragment slot="below">
      <p class="lead">{q(service.oneLiner)}</p>
      <p class="masthead__actions"><a class="btn" href={service.cta.href}>{service.cta.label}</a></p>
      {types && (
        <nav class="jump" aria-label={service.tracksHeading}>
          <ul role="list">
            {types.map((type: { id: string; label: string }) => <li><a class="textlink" href={`#${type.id}`}>{type.label}</a></li>)}
            <li><a class="textlink" href="#offers">{offerSet!.marker}</a></li>
          </ul>
        </nav>
      )}
    </Fragment>
  </Masthead>

  {/* Producers listen before they read: the portfolio comes first. */}
  {service.portfolioHeading && service.samplesPending && (
    <section id="portfolio" class="sec sec--band" aria-labelledby="portfolio-heading">
      <div class="bleed">
        {/* The word 'Voice', slightly larger, with no number or dash; the heading on the same step as
            the page's other headings, so the sections share one scale (client revisions, November 2026). */}
        <SectionHead label={service.routeLabel} labelLarge heading={service.portfolioHeading} headingSmall id="portfolio-heading" />
        <TrackList />
      </div>
    </section>
  )}

  {/* Teaching: her three types, then the ways to work together as cards
      (client revisions, November 2026). */}
  {types && (
    <section class="sec sec--cream" aria-labelledby="types-heading">
      <div class="bleed">
        <SectionHead label={service.tracksHeading} labelAs="h2" lead={service.rangeLine} id="types-heading" />
        <div class="types col-wide">
          {types.map((type: { id: string; label: string; tagline: string; body: string }) => (
            <article class="type reveal" id={type.id} aria-labelledby={`${type.id}-title`}>
              <h3 class="h3" id={`${type.id}-title`}>{type.label}</h3>
              <p class="type__tagline">{q(type.tagline)}</p>
              <p class="muted">{q(type.body)}</p>
            </article>
          ))}
        </div>
        {service.note && (
          <div class="col-text space-7">
            <Note heading={service.note.heading} body={service.note.body} />
          </div>
        )}
      </div>
    </section>
  )}

  {offerSet && types && (
    <section class="sec sec--band" id="offers" aria-labelledby="offers-heading">
      <div class="bleed">
        <SectionHead label={offerSet.marker} labelAs="h2" lead={offerSet.availableFor} id="offers-heading" />
        <div class="offers-wrap"><OfferCards service={service.offers} route={service.route} /></div>
        <div class="prose col-text offers__after">
          <p class="small muted">{q(offerSet.note)}</p>
          <p class="small">{offerSet.unsure.before} <a class="textlink" href={unsureHref}>{offerSet.unsure.link}</a> {offerSet.unsure.after}</p>
        </div>
      </div>
    </section>
  )}

  <section class="sec" aria-labelledby="problem-heading">
    <div class="bleed">
      <SectionHead label={service.problemLabel ?? labels.problemLabelDefault} labelAs="h2" id="problem-heading" />
      <div class="prose col-text">
        {/* Running copy in the home page's body face, one style throughout (client revisions, November 2026). */}
        {service.problem.map((line: string) => <p class="reveal">{q(line)}</p>)}
      </div>
      <div class="col-text space-7">
        <Note heading={service.aside.heading} body={service.aside.body} />
      </div>
      {service.swap && (
        <div class="swap col-text reveal">
          <div><p class="label">{service.swap.fromLabel}</p><p>{q(service.swap.from)}</p></div>
          <div><p class="label">{service.swap.toLabel}</p><p>{q(service.swap.to)}</p></div>
        </div>
      )}
      {service.voiceHeading && (
        <div class="prose col-text voice reveal">
          <h3 class="h3">{service.voiceHeading}</h3>
          <p>{q(service.voiceBody)}</p>
          <ul class="tagline" role="list">{service.voiceTags.map((tag: string) => <li>{tag}</li>)}</ul>
        </div>
      )}
    </div>
  </section>

  {service.tracks && (
    <section class="sec sec--band" aria-labelledby="tracks-heading">
      <div class="bleed">
        <SectionHead label={service.tracksHeading} labelAs="h2" lead={service.rangeLine} id="tracks-heading" />
        <dl class="pairs col-wide">
          {service.tracks.map((track: { label: string; body: string }) => (
            <div class="reveal"><dt>{track.label}</dt><dd>{q(track.body)}</dd></div>
          ))}
        </dl>
        {service.note && (
          <div class="col-text space-7">
            <Note heading={service.note.heading} body={service.note.body} />
          </div>
        )}
      </div>
    </section>
  )}

  <section class="sec sec--cream" aria-labelledby="method-heading">
    <div class="bleed">
      <SectionHead label={service.methodHeading} labelAs="h2" id="method-heading" />
      <ol class="steps" role="list">
        {service.method.map((step: { title: string; body: string }) => (
          <li class="reveal"><strong>{step.title}</strong>{step.body && <span>{q(step.body)}</span>}</li>
        ))}
      </ol>
      <div class="prose col-text space-7">
        {service.footnote && <p class="small muted">{q(service.footnote)}</p>}
        <a class="textlink" href={service.cta.href}>{service.cta.label} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {/* Repurpose: her introduction, then the packages as cards (client revisions, November 2026). */}
  {offerSet && !types && (
    <section class="sec sec--band" id="offers" aria-labelledby="offers-heading">
      <div class="bleed">
        <SectionHead label={offerSet.marker} heading={offerSet.intro.heading} lead={offerSet.intro.standfirst} id="offers-heading" />
        <div class="prose col-text">
          {offerSet.intro.paragraphs.map((line: string) => <p>{q(line)}</p>)}
        </div>
        <dl class="pairs col-wide space-7">
          {offerSet.intro.services.map((sv: { label: string; body: string }) => <div class="reveal"><dt>{sv.label}</dt><dd>{q(sv.body)}</dd></div>)}
        </dl>
        <p class="col-text space-7">{q(offerSet.intro.close)}</p>
        <div class="offers-wrap space-8"><OfferCards service={service.offers} route={service.route} /></div>
        <div class="prose col-text offers__after">
          <p class="small">{q(offerSet.custom)}</p>
          <p class="small">{offerSet.unsure.before} <a class="textlink" href={unsureHref}>{offerSet.unsure.link}</a> {offerSet.unsure.after}</p>
        </div>
      </div>
    </section>
  )}

  {service.publishPricing === true && service.tiers && !offerSet && (
    <section class="sec sec--band" aria-labelledby="pricing-heading">
      <div class="bleed">
        <SectionHead label={service.pricingHeading} labelAs="h2" lead={service.pricingLine} id="pricing-heading" />
        <PriceList tiers={service.tiers} />
        {service.agreements?.length > 0 && (
          <>
            <h3 class="h3 col-text space-8">{service.agreementsHeading}</h3>
            <div class="agreements space-5">
              {service.agreements.map((a: { heading: string; body: string }) => (
                <div class="reveal"><p class="h3">{q(a.heading)}</p><p class="muted">{q(a.body)}</p></div>
              ))}
            </div>
          </>
        )}
      </div>
    </section>
  )}

  {types && service.agreements?.length > 0 && (
    <section class="sec sec--band" aria-labelledby="expect-heading">
      <div class="bleed">
        <SectionHead label={service.agreementsHeading} labelAs="h2" id="expect-heading" />
        <div class="agreements">
          {service.agreements.map((a: { heading: string; body: string }) => (
            <div class="reveal"><p class="h3">{q(a.heading)}</p><p class="muted">{q(a.body)}</p></div>
          ))}
        </div>
        {/* The Teach credentials moved to the home page's list (client revisions, November 2026). */}
      </div>
    </section>
  )}

  {hasDetails && (
    <section class="sec sec--minor" aria-labelledby="details-heading">
      <div class="bleed">
        <SectionHead label={labels.detailsMarker} labelAs="h2" id="details-heading" />
        <div class="prose col-text">
          {service.studioHeading && service.studio && <Note heading={service.studioHeading} body={service.studio} />}
          {service.examplesHeading && service.examples?.length > 0 && (
            <Note heading={service.examplesHeading}>{service.examples.map((e: string) => <p>{q(e)}</p>)}</Note>
          )}
          {service.background && (
            <Note heading={service.background.heading}>
              {background
                ? <p>{q(background.before)}<a href={background.href} target="_blank" rel="noopener noreferrer">{background.text}<span class="visually-hidden">{global.newTab}</span></a>{q(background.after)}</p>
                : <p>{q(service.background.body)}</p>}
            </Note>
          )}
        </div>
      </div>
    </section>
  )}

  {/* A portfolio only where real, approved examples exist: no placeholder. */}
  {service.portfolioHeading && service.portfolioPending && service.examples?.length > 0 && (
    <section id="portfolio" class="sec sec--minor" aria-labelledby="work-heading">
      <div class="bleed">
        <SectionHead label={service.portfolioHeading} labelAs="h2" id="work-heading" />
        <div class="prose col-text reveal">
          {service.examples.map((e: string) => <p>{q(e)}</p>)}
          <a class="textlink" href={service.cta.href}>{service.portfolioLink.label} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  )}

  {/* Testimonials appear only once there are real ones: no placeholder. */}
  {service.showTestimonials && service.proofHeading && service.proof?.length > 0 && (
    <section id="testimonials" class="sec sec--minor" aria-labelledby="testimonials-heading">
      <div class="bleed">
        <SectionHead label={service.proofHeading} labelAs="h2" id="testimonials-heading" />
        <div class="prose col-text reveal">
          {service.proof.map((item: { quote: string; attribution?: string }) => (
            <blockquote><p class="lead">{q(item.quote)}</p>{item.attribution && <footer class="label">{item.attribution}</footer>}</blockquote>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Onward links: plainly navigation, set apart from the page text. */}
  <nav class="sec sec--band onward" aria-labelledby="other-heading">
    <div class="bleed">
      <SectionHead label={labels.otherMarker} labelAs="h2" id="other-heading" />
      <div class="col-wide"><ServiceList exclude={service.route} /></div>
    </div>
  </nav>
</Base>
