---
/**
 * Every page: head and meta, the header, the close, the photograph grades,
 * the scroll reveals and the once-per-session wordmark. Direction B.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import global from '../content/global.json';

interface Props {
  /** Page title. The brand name is appended unless `bare`. */
  title: string;
  description?: string;
  bare?: boolean;
  noindex?: boolean;
}

const { title, description, bare = false, noindex = false } = Astro.props;

const pageTitle = bare ? title : `${title} — ${global.meta.titleSuffix}`;
const pageDescription = description ?? global.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = global.meta.ogImage ? new URL(global.meta.ogImage, Astro.site).href : null;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

/* The photograph grade. Mirrors --duo-shadow and --paper in tokens.css
   (SVG filter tables need numbers, not custom properties). Every photo is
   black and white, so luminance maps straight from one colour to the
   other. The lifted variant pulls the mid-tones toward the paper for a
   photograph that carries type; its two ends are the same. */
const SHADOW = '#2E1F29';
const PAPER = '#F1E6D9';
const channel = (hex: string, i: number) => parseInt(hex.slice(1 + i * 2, 3 + i * 2), 16) / 255;
const duo = [0, 1, 2].map((i) => `${channel(SHADOW, i).toFixed(4)} ${channel(PAPER, i).toFixed(4)}`);
const duoLift = [0, 1, 2].map((i) => {
  const [s, p] = [channel(SHADOW, i), channel(PAPER, i)];
  return `${s.toFixed(4)} ${(s * 0.38 + p * 0.62).toFixed(4)} ${p.toFixed(4)}`;
});
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.meta.titleSuffix} />
    <meta property="og:locale" content={global.meta.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <meta name="theme-color" content={global.meta.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/literata-roman.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />

    {/* The wordmark inks in on the first page of a visit only. Set before
        first paint so it never flashes in finished and then animates. */}
    <script is:inline>
      try {
        if (!sessionStorage.getItem('atw-inked')) {
          document.documentElement.classList.add('ink-in');
          sessionStorage.setItem('atw-inked', '1');
        }
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">{global.skipLink}</a>

    <svg aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute">
      <filter id="duotone" color-interpolation-filters="sRGB">
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncR type="table" tableValues={duo[0]} />
          <feFuncG type="table" tableValues={duo[1]} />
          <feFuncB type="table" tableValues={duo[2]} />
        </feComponentTransfer>
      </filter>
      <filter id="duotone-lift" color-interpolation-filters="sRGB">
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncR type="table" tableValues={duoLift[0]} />
          <feFuncG type="table" tableValues={duoLift[1]} />
          <feFuncB type="table" tableValues={duoLift[2]} />
        </feComponentTransfer>
      </filter>
      <filter id="graphite" x="-5%" y="-50%" width="110%" height="200%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="4" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="2.4" />
      </filter>
    </svg>

    <Header currentPath={currentPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  /* ---- Menus ----
     <details> does the opening. This only closes the others when one opens,
     closes all on Escape or an outside click, and returns focus. */
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-sub]'));
  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (menu.open) menus.forEach((other) => { if (other !== menu && !other.contains(menu)) other.open = false; });
    });
  }
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = menus.find((menu) => menu.open);
    if (!open) return;
    menus.forEach((menu) => { menu.open = false; });
    open.querySelector('summary')?.focus();
  });
  document.addEventListener('click', (event) => {
    menus.forEach((menu) => { if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
  });

  /* ---- Scroll reveals ----
     Only an element that is below the fold when the page loads is ever
     hidden, so nothing a reader can already see waits on animation, and if
     this never runs the page is simply whole. Siblings step in one after
     another. Under reduced motion the tokens make this a short fade with
     no movement. */
  try {
    if ('IntersectionObserver' in window) {
      const fold = window.innerHeight * 0.92;
      const pending = Array.from(document.querySelectorAll<HTMLElement>('.reveal')).filter(
        (el) => el.getBoundingClientRect().top > fold
      );
      const index = new Map<Element | null, number>();
      for (const el of pending) {
        const i = index.get(el.parentElement) ?? 0;
        index.set(el.parentElement, i + 1);
        el.style.setProperty('--i', String(Math.min(i, 6)));
        el.classList.add('reveal-pending');
      }
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.12 });
      pending.forEach((el) => observer.observe(el));
    }
  } catch {
    document.querySelectorAll('.reveal-pending').forEach((el) => el.classList.add('is-in'));
  }
</script>
