---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import global from '../content/global.json';
import Button from '../components/Button.astro';

interface Props {
  /** Page title. The brand name is appended unless `bare`. */
  title: string;
  description?: string;
  bare?: boolean;
  noindex?: boolean;
  /**
   * Temporary preview chrome. On by default while the site is being shown for
   * approval; flip the default to false at launch and it disappears everywhere.
   */
  showPreviewBanner?: boolean;
}

const {
  title,
  description,
  bare = false,
  noindex = false,
  showPreviewBanner = true,
} = Astro.props;

const pageTitle = bare ? title : `${title} — ${global.meta.titleSuffix}`;
const pageDescription = description ?? global.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = global.meta.ogImage ? new URL(global.meta.ogImage, Astro.site).href : null;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

/* Never render a dead link. Both lists ship with null hrefs until the content
   exists, and the whole column or list is dropped rather than emptied. */
const socialLinks = global.social.links.filter((link) => link.url);
const legalLinks = global.footer.legalLinks.filter((item) => item.href);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    {/* Only the two faces used above the fold, and only their latin subsets. */}
    <link rel="preload" href="/fonts/jost-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.meta.titleSuffix} />
    <meta property="og:locale" content={global.meta.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    {/* summary_large_image with no image renders as a broken card. */}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <meta name="theme-color" content={global.meta.themeColor} />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">{global.skipLink}</a>

    <div class="grain" aria-hidden="true"></div>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/" aria-label={`${global.brand.wordmark}, home`}>
          {global.brand.wordmark}
        </a>

        <nav class="site-nav" aria-label="Primary">
          <ul class="site-nav__list" role="list">
            {
              global.nav.items.map((item) => {
                const isCurrent =
                  item.href === '/'
                    ? currentPath === '/'
                    : currentPath === item.href || currentPath.startsWith(`${item.href}/`);
                return (
                  <li>
                    <a
                      class="site-nav__link"
                      href={item.href}
                      aria-current={isCurrent ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>

        {/* Secondary, so the page's own hero keeps the one primary button. */}
        <Button variant="secondary" href={global.nav.cta.href}>{global.nav.cta.label}</Button>
      </div>
    </header>

    {/* An aside, not role="status": this text never changes, so a live region
        was wrong, and outside a landmark it was unreachable by landmark nav. */}
    {
      showPreviewBanner && (
        <aside class="preview-banner" aria-label="Site status">
          <p>{global.banner.text}</p>
        </aside>
      )
    }

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__wordmark">{global.brand.wordmark}</p>
          <p class="site-footer__tagline">{global.footer.tagline}</p>
        </div>

        <div class="site-footer__cols">
          {
            global.footer.columns.map((column) => (
              <div class="site-footer__col">
                <p class="site-footer__heading">{column.heading}</p>
                <ul role="list">
                  {column.links.map((link) => (
                    <li><a href={link.href}>{link.label}</a></li>
                  ))}
                </ul>
              </div>
            ))
          }

          {
            socialLinks.length > 0 && (
              <div class="site-footer__col">
                <p class="site-footer__heading">{global.social.heading}</p>
                <ul role="list">
                  {socialLinks.map((link) => (
                    <li><a href={link.url} rel="me noopener">{link.label}</a></li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <div class="site-footer__legal">
          <p>{global.footer.legal}</p>
          {
            legalLinks.length > 0 && (
              <ul role="list">
                {legalLinks.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Content sits above the fixed grain layer (z-index 1 in tokens.css). */
  .site-header,
  .site-main,
  .site-footer,
  .preview-banner {
    position: relative;
    z-index: 2;
  }

  .site-main {
    flex: 1;
  }

  /* ---- Preview banner ---- */

  .preview-banner {
    background: var(--clay-ink);
    color: var(--paper);
    text-align: center;
    padding-block: var(--s-3);
    padding-inline: var(--gutter-x-sm);
  }

  .preview-banner p {
    margin: 0;
    max-inline-size: none;
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    line-height: 1.3;
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
  }

  /* ---- Header ---- */

  .site-header {
    border-bottom: var(--border);
  }

  .site-header__inner {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter-x);
    padding-block: var(--s-5);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
    flex-wrap: wrap;
  }

  /* 18px lockup offset, from brief §1.4. One of the two sanctioned off-scale
     values on the site. */
  .wordmark {
    margin-left: 18px;
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--clay-ink);
  }

  /* Wordmark left, nav and CTA grouped right. */
  .site-nav {
    margin-left: auto;
  }

  .site-nav__list {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-5);
    list-style: none;
  }

  .site-nav__link {
    font-family: var(--font-body);
    font-size: var(--t-small);
    text-transform: lowercase;
    text-decoration: none;
    color: var(--ink);
    padding-bottom: var(--s-1);
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .site-nav__link:hover {
    color: var(--clay-ink);
  }

  /* Current page is heavier as well as coloured, so hover and current are not
     the same state wearing the same clothes. */
  .site-nav__link[aria-current='page'] {
    color: var(--clay-ink);
    font-weight: 500;
    border-bottom-color: var(--clay);
  }

  @media (max-width: 1023px) {
    .site-nav {
      margin-left: 0;
    }
  }

  @media (max-width: 767px) {
    .site-header__inner {
      padding-block: var(--s-4);
      gap: var(--s-3);
    }

    .wordmark {
      margin-left: 0;
    }

    .site-nav__list {
      gap: var(--s-4);
    }
  }

  /* ---- Footer ---- */

  /* clay-ink is near-invisible on the dark band and on the banner, so the
     focus ring swaps to paper in both. */
  .site-footer :focus-visible,
  .preview-banner :focus-visible {
    outline-color: var(--paper);
  }

  .site-footer {
    background: var(--surface-dark);
    color: var(--paper);
  }

  .site-footer__inner {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter-x);
    padding-block: var(--s-9) var(--s-6);
    display: grid;
    gap: var(--s-8);
  }

  .site-footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--paper);
    margin: 0;
  }

  .site-footer__tagline {
    margin-top: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--t-lead);
    font-weight: 300;
    font-style: italic;
    line-height: 1.4;
    color: var(--coconut);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--s-11), 1fr));
    gap: var(--s-6);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--coconut);
    margin: 0 0 var(--s-3);
  }

  .site-footer__col ul {
    list-style: none;
    display: grid;
    gap: var(--s-3);
  }

  /* Underlined. These were paper text on a paper-coloured run of prose with no
     underline and no weight change — no channel distinguished a link at all. */
  .site-footer__col a {
    font-size: var(--t-small);
    color: var(--paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(in srgb, var(--paper) 45%, transparent);
    transition: text-decoration-color var(--dur-fast) var(--ease);
  }

  .site-footer__col a:hover {
    text-decoration-color: var(--paper);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
  }

  /* Mono is permitted on the footer legal line. Brief §3.4, item 5. */
  .site-footer__legal,
  .site-footer__legal a {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    color: var(--coconut);
  }

  .site-footer__legal p {
    margin: 0;
  }

  .site-footer__legal ul {
    list-style: none;
    display: flex;
    gap: var(--s-4);
  }

  .site-footer__legal a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(in srgb, var(--coconut) 45%, transparent);
    transition: text-decoration-color var(--dur-fast) var(--ease);
  }

  .site-footer__legal a:hover {
    text-decoration-color: var(--coconut);
  }
</style>
