---
/* Fraunces ships with its optical-size axis; Inter does not.

   Fraunces runs from 17px on a pillar card to 62px in the masthead, and the
   weight-only file collapses that whole range onto one 14pt master — which is
   why the big type looked loosely fitted and the small italic looked coarse.
   The opsz cut costs ~67KB and `font-optical-sizing: auto` in global.css
   spends it.

   Inter is set between 15px and 24px here, and its opsz axis only spans
   14–32, so the same swap would buy a difference almost nobody could see for
   another 23KB on the mobile critical path. Not worth it: the tracking ladder
   in tokens.css does that job instead. `font-optical-sizing: auto` simply has
   no axis to act on and no-ops. */
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import global from '../content/global.json';
import Button from '../components/Button.astro';
import NavMenu from '../components/NavMenu.astro';

interface Props {
  /** Page title. The brand name is appended unless `bare`. */
  title: string;
  description?: string;
  bare?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  bare = false,
  noindex = false,
} = Astro.props;

const pageTitle = bare ? title : `${title} — ${global.meta.titleSuffix}`;
const pageDescription = description ?? global.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = global.meta.ogImage ? new URL(global.meta.ogImage, Astro.site).href : null;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

/* Never render a dead link. Both lists ship with null hrefs until the content
   exists, and the whole column or list is dropped rather than emptied. */
const socialLinks = global.social.links.filter((link) => link.url);
const legalLinks = global.footer.legalLinks.filter((item) => item.href);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        document.documentElement.classList.add('reveal-enabled');
        window.__atwRevealFallback = window.setTimeout(() => {
          document.documentElement.classList.remove('reveal-enabled');
        }, 3000);
      }
    </script>
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={global.meta.titleSuffix} />
    <meta property="og:locale" content={global.meta.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    {/* summary_large_image with no image renders as a broken card. */}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <meta name="theme-color" content={global.meta.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ClientRouter fallback="animate" />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">{global.skipLink}</a>

    <div class="grain" aria-hidden="true"></div>

    <header class="site-header">
      <div class="site-header__inner">
        <a class="wordmark" href="/" aria-label={`${global.brand.wordmark}, home`}>
          {global.brand.wordmark}
        </a>

        <NavMenu items={global.nav.items} currentPath={currentPath} />

        {/* A conversion action, not one of the five navigation items. Keep it
            visible; it becomes the booking entry point once Calendly is ready. */}
        <Button variant="secondary" href={global.nav.cta.href}>{global.nav.cta.label}</Button>
      </div>
    </header>

    <main id="main" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__wordmark">{global.brand.wordmark}</p>
          <p class="site-footer__tagline">{global.footer.tagline}</p>
        </div>

        <div class="site-footer__cols">
          {
            global.footer.columns.map((column) => (
              <div class="site-footer__col">
                <p class="site-footer__heading">{column.heading}</p>
                <ul role="list">
                  {column.links.map((link) => (
                    <li><a href={link.href}>{link.label}</a></li>
                  ))}
                </ul>
              </div>
            ))
          }

          {
            socialLinks.length > 0 && (
              <div class="site-footer__col">
                <p class="site-footer__heading">{global.social.heading}</p>
                <ul role="list">
                  {socialLinks.map((link) => (
                    <li><a href={link.url} rel="me noopener">{link.label}</a></li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        <div class="site-footer__legal">
          <p>{global.footer.legal}</p>
          {
            legalLinks.length > 0 && (
              <ul role="list">
                {legalLinks.map((item) => (
                  <li><a href={item.href}>{item.label}</a></li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Content sits above the fixed grain layer (z-index 1 in tokens.css). */
  .site-header,
  .site-main,
  .site-footer {
    position: relative;
    z-index: 2;
  }

  .site-main {
    flex: 1;
  }

  /* ---- Header ---- */

  .site-header {
    border-bottom: var(--border);
  }

  .site-header__inner {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter-x);
    padding-block: var(--s-5);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
    flex-wrap: wrap;
  }

  /* 18px lockup offset, from brief §1.4. One of the two sanctioned off-scale
     values on the site. */
  .wordmark {
    margin-left: 18px;
    font-family: var(--font-display);
    font-size: var(--t-h3);
    font-weight: 400;
    line-height: 1;
    letter-spacing: var(--track-h3);
    text-transform: lowercase;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);
  }

  .wordmark:hover {
    color: var(--clay-ink);
  }

  @media (max-width: 767px) {
    .site-header__inner {
      padding-block: var(--s-4);
      gap: var(--s-3);
    }

    .wordmark {
      margin-left: 0;
    }
  }

  /* ---- Footer ---- */

  /* clay-ink is near-invisible on the dark footer band. */
  .site-footer :focus-visible {
    outline-color: var(--paper);
  }

  .site-footer {
    background: var(--surface-dark);
    color: var(--paper);
  }

  .site-footer__inner {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter-x);
    padding-block: var(--s-9) var(--s-6);
    display: grid;
    gap: var(--s-8);
  }

  .site-footer__wordmark {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 300;
    line-height: var(--lh-h2);
    letter-spacing: var(--track-h2);
    color: var(--paper);
    margin: 0;
  }

  .site-footer__tagline {
    margin-top: var(--s-4);
    font-family: var(--font-display);
    font-size: var(--t-lead);
    font-weight: 300;
    font-style: italic;
    line-height: 1.4;
    letter-spacing: var(--track-lead);
    color: var(--coconut);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--s-11), 1fr));
    gap: var(--s-6);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--track-mono);
    margin: 0 0 var(--s-4);
    margin-inline-end: calc(var(--track-mono) * -1);
    padding-block-end: var(--s-3);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 16%, transparent);
    text-transform: uppercase;
    color: var(--coconut);
  }

  .site-footer__col ul {
    list-style: none;
    display: grid;
    gap: var(--s-3);
  }

  /* Underlined. These were paper text on a paper-coloured run of prose with no
     underline and no weight change — no channel distinguished a link at all. */
  .site-footer__col a {
    font-size: var(--t-small);
    letter-spacing: var(--track-small);
    color: var(--paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(in srgb, var(--paper) 45%, transparent);
    transition: text-decoration-color var(--dur-fast) var(--ease);
  }

  .site-footer__col a:hover {
    text-decoration-color: var(--paper);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-top: var(--s-5);
    border-top: 1px solid color-mix(in srgb, var(--paper) 18%, transparent);
  }

  /* Mono is permitted on the footer legal line. Brief §3.4, item 5. */
  .site-footer__legal,
  .site-footer__legal a {
    font-family: var(--font-mono);
    font-size: var(--t-mono);
    letter-spacing: var(--track-mono);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--coconut);
  }

  .site-footer__legal p {
    margin: 0;
    margin-inline-end: calc(var(--track-mono) * -1);
  }

  .site-footer__legal a {
    margin-inline-end: calc(var(--track-mono) * -1);
  }

  .site-footer__legal ul {
    list-style: none;
    display: flex;
    gap: var(--s-4);
  }

  .site-footer__legal a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: color-mix(in srgb, var(--coconut) 45%, transparent);
    transition: text-decoration-color var(--dur-fast) var(--ease);
  }

  .site-footer__legal a:hover {
    text-decoration-color: var(--coconut);
  }
</style>

<script>
  /* ---- Progressive reveal ----
     The stylesheet decides WHAT fades (section 6 of global.css); this decides
     WHEN. Keep REVEAL_PARTS and NESTED_PARTS in step with the two selector
     lists there.

     Targets are leaf blocks — a heading, a paragraph, one card, one credential
     — not section wrappers, so a section resolves top to bottom. A wrapper that
     contains targets of its own is skipped here for the same reason the
     stylesheet skips it: its own fade would sit on top of the children's and
     flatten the stagger. */

  const REVEAL_SCOPES = [
    '.hero:not(.page-hero)',
    '.section',
    '.library',
    '.site-footer',
  ];

  const REVEAL_PARTS = [
    '.editorial > *',
    '.stack > *',
    '.split > *',
    '.meaning-layout > *',
    '.columns > li',
    '.credentials__item',
    '.steps > li',
    '.rows-dl__row',
    '.content-grid > li',
    '.agreements > *',
    '.site-footer__col',
    '.site-footer__brand',
  ];

  /* A layout container lays out targets; it is never a target itself. */
  const REVEAL_CONTAINERS = [
    '.stack',
    '.split',
    '.meaning-layout',
    '.columns',
    '.credentials',
    '.steps',
    '.rows-dl',
    '.content-grid',
    '.agreements',
  ];

  const revealSelector = REVEAL_SCOPES.flatMap((scope) =>
    REVEAL_PARTS.map((part) => `${scope} ${part}`)
  ).join(',');
  const containerSelector = REVEAL_CONTAINERS.join(',');

  /* Eight steps of 70ms is just over half a second across a group. Past that
     the last card in a long row arrives after the reader has reached it. */
  const MAX_STEPS = 7;

  let revealObserver: IntersectionObserver | undefined;
  let removeScrollFallback: (() => void) | undefined;

  function initialiseRevealMotion() {
    revealObserver?.disconnect();
    removeScrollFallback?.();
    revealObserver = undefined;
    removeScrollFallback = undefined;

    const root = document.documentElement;
    const fallback = (window as typeof window & { __atwRevealFallback?: number })
      .__atwRevealFallback;

    if (!root.classList.contains('reveal-enabled')) return;

    /* A component that ships a <script> renders it as a child of whatever
       wrapper it sits in, so it matched `.stack > *` and consumed a step —
       every sibling after it arrived one beat late for nothing. */
    const NOT_RENDERED = new Set(['SCRIPT', 'STYLE', 'TEMPLATE', 'NOSCRIPT', 'LINK', 'META']);

    const targets = Array.from(
      document.querySelectorAll<HTMLElement>(revealSelector)
    ).filter(
      (element) =>
        !element.matches(containerSelector) && !NOT_RENDERED.has(element.tagName)
    );

    /* Delays run per group, so each cluster cascades from its own first item
       rather than inheriting a delay from whatever preceded it on the page. */
    const seen = new Map<Element | null, number>();

    for (const target of targets) {
      const group = target.parentElement;
      const index = seen.get(group) ?? 0;
      seen.set(group, index + 1);
      target.style.setProperty(
        '--reveal-delay',
        `calc(${Math.min(index, MAX_STEPS)} * var(--reveal-step))`
      );
    }

    if ('IntersectionObserver' in window) {
      revealObserver = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        },
        /* Any part of the block crossing 90% of the viewport is enough.
           A threshold measured as a fraction of the element never fires
           reliably for a block taller than the viewport. */
        { rootMargin: '0px 0px -10% 0px', threshold: 0 }
      );

      for (const target of targets) revealObserver.observe(target);
    } else {
      /* Some embedded preview browsers omit IntersectionObserver. A small,
         passive scroll fallback keeps the reveal behaviour functional there. */
      const revealVisible = () => {
        const revealLine = window.innerHeight * 0.92;
        for (const target of targets) {
          if (target.classList.contains('is-revealed')) continue;
          if (target.getBoundingClientRect().top <= revealLine) {
            target.classList.add('is-revealed');
          }
        }

        if (targets.every((target) => target.classList.contains('is-revealed'))) {
          removeScrollFallback?.();
        }
      };

      const removeListeners = () => {
        window.removeEventListener('scroll', revealVisible);
        window.removeEventListener('resize', revealVisible);
      };

      removeScrollFallback = removeListeners;
      window.addEventListener('scroll', revealVisible, { passive: true });
      window.addEventListener('resize', revealVisible);
      requestAnimationFrame(revealVisible);
    }

    if (fallback) window.clearTimeout(fallback);
  }

  initialiseRevealMotion();
  document.addEventListener('astro:page-load', initialiseRevealMotion);
</script>
